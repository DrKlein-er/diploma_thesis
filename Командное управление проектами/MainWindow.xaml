<Window x:Class="Командное_управление_проектами.MainWindow"
        Icon="pack://application:,,,/Resources/checklist.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dxsch="http://schemas.devexpress.com/winfx/2008/xaml/scheduler"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:local="clr-namespace:Командное_управление_проектами"
        xmlns:converters="clr-namespace:Командное_управление_проектами.Converters"
        mc:Ignorable="d"
        Title="Система управления проектами" Height="850" Width="1500" WindowStartupLocation="CenterScreen"
        WindowState="Maximized" Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

        <!-- Градиент для верхней панели - адаптируется к теме -->
        <LinearGradientBrush x:Key="TopPanelBackground" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{Binding Source={StaticResource AccentBrush}, Path=Color}" Offset="0"/>
            <GradientStop Color="#005F99" Offset="1"/>
        </LinearGradientBrush>

        <!-- ==================== СТИЛИ КНОПОК ==================== -->

        <!-- Стиль для кнопки "Выход" -->
        <Style x:Key="ExitButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B71C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#9A0007"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок действий (Зелёная - Добавить) -->
        <Style x:Key="AddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45A049"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3D8B40"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок редактирования (Жёлтая) -->
        <Style x:Key="EditButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFB300"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFA000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок удаления (Красная) -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F44336"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E53935"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D32F2F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок действий общего назначения (Синяя) -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004578"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок специального назначения (Фиолетовая - Диаграмма Ганта и т.д.) -->
        <Style x:Key="SpecialButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#5C6BC0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="4" 
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5461B5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4A56A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportPDFButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="4" 
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D43F31"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C0392B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок экспорта Excel (Зелёная) -->
        <Style x:Key="ExportExcelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="4" 
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#229954"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E8449"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel Background="{DynamicResource BackgroundBrush}">
        <!-- Верхняя панель -->
        <Border DockPanel.Dock="Top" 
                Background="{StaticResource TopPanelBackground}" 
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="WelcomeText" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="White"
                           VerticalAlignment="Center" 
                           Grid.Column="0"/>
                <Button Content="Выход" 
                        Style="{StaticResource ExitButtonStyle}" 
                        Click="Logout_Click" 
                        Grid.Column="1" 
                        Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- Боковая панель навигации -->
        <StackPanel x:Name="MenuPanel" 
            DockPanel.Dock="Left" 
            Width="220" 
            Background="{DynamicResource MenuBackgroundBrush}">

            <!-- Заголовок панели -->
            <Border Background="{DynamicResource AccentBrush}" 
            Padding="15" 
            Margin="5,5,5,15">
                <StackPanel>
                    <TextBlock Text="Навигация" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Button x:Name="CalendarButton" 
            Content="Календарь" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowCalendar"/>
            <Button x:Name="ProjectsButton" 
            Content="Проекты" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowProjects"/>
            <Button x:Name="TasksButton" 
            Content="Задачи" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowTasks"/>
            <Button x:Name="EventsButton" 
            Content="События" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowEvents"/>
            <Button x:Name="RemindersButton" 
            Content="Напоминания" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowReminders"/>
            <Button x:Name="NotesButton" 
            Content="Заметки" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowNotes"/>
            <Button x:Name="NotificationsButton" 
            Content="Уведомления" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowNotifications"/>
            <Button x:Name="ChatButton" 
            Content="Чат" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowChat"/>
            <Button x:Name="ReportsButton" 
            Content="Отчёты" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowReports" 
            Visibility="Collapsed"/>
            <Button x:Name="UsersButton" 
            Content="Пользователи" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowUsers" 
            Visibility="Collapsed"/>

            <!-- Разделитель -->
            <Border Height="1" 
            Background="{DynamicResource BorderBrush}" 
            Margin="10,10"/>

            <Button x:Name="ProfileButton" 
            Content="Профиль" 
            Click="ShowProfile" 
            Style="{StaticResource MenuButtonStyle}"/>
        </StackPanel>

        <!-- Центральная зона -->
        <Grid x:Name="MainContent" Background="{DynamicResource BackgroundBrush}">

            <!-- ==================== ПАНЕЛЬ КАЛЕНДАРЯ ==================== -->
            <Grid x:Name="CalendarPanel" Visibility="Visible" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,10" 
                           Grid.Row="0">
                    <Button x:Name="PrevMonthButton" 
                            Content="◄" 
                            Click="PrevMonthButton_Click" 
                            Style="{StaticResource MenuButtonStyle}" 
                            Width="40" 
                            Height="40"/>
                    <TextBlock x:Name="MonthYearLabel" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource ForegroundBrush}"
                               Margin="10,0" 
                               VerticalAlignment="Center"/>
                    <Button x:Name="NextMonthButton" 
                            Content="►" 
                            Click="NextMonthButton_Click" 
                            Style="{StaticResource MenuButtonStyle}" 
                            Width="40" 
                            Height="40"/>
                </StackPanel>

                <Border Grid.Row="1" 
                        Background="{DynamicResource BackgroundBrush}" 
                        CornerRadius="8" 
                        Padding="10" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1">
                    <ItemsControl x:Name="CalendarItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </Grid>

            <!-- ==================== ПАНЕЛЬ ПРОЕКТОВ ==================== -->
            <StackPanel x:Name="ProjectsPanel" Visibility="Collapsed" Margin="10">
                <TextBlock Text="Проекты" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,20" 
                           HorizontalAlignment="Center"/>

                <Border Background="{DynamicResource BackgroundBrush}" 
                        CornerRadius="8" 
                        Padding="15" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1">
                    <StackPanel>
                        <!-- Фильтры -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Название:" 
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="14" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"
                                     x:Name="ProjectNameSearchBox" 
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     TextChanged="ProjectFilters_Changed" 
                                     Margin="0,0,20,0"/>

                            <TextBlock Grid.Column="2"
                                       Text="Ответственный:" 
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="14" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0"/>
                            <TextBox Grid.Column="3"
                                     x:Name="ProjectResponsibleSearchBox" 
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     TextChanged="ProjectFilters_Changed" 
                                     Margin="0,0,20,0"/>

                            <TextBlock Grid.Column="4"
                                       Text="Период:" 
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="14" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="0,0,20,0">
                                <DatePicker x:Name="ProjectStartDatePicker" 
                                           SelectedDateChanged="ProjectFilters_Changed" 
                                           Width="120" 
                                           Height="32"
                                           Margin="0,0,5,0"/>
                                <TextBlock Text="до" 
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           VerticalAlignment="Center" 
                                           Margin="5,0"/>
                                <DatePicker x:Name="ProjectEndDatePicker" 
                                           SelectedDateChanged="ProjectFilters_Changed" 
                                           Width="120" 
                                           Height="32"
                                           Margin="5,0,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="6"
                                    Content="Сброс фильтров" 
                                    Click="ResetProjectFiltersBtn_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                        </Grid>

                        <!-- Кнопки действий -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button x:Name="AddProjectBtn" 
                                    Content="Добавить проект" 
                                    Click="AddProject_Click" 
                                    Margin="0,0,10,0"
                                    Style="{StaticResource AddButtonStyle}"/>

                            <Button x:Name="EditProjectBtn" 
                                    Content="Редактировать" 
                                    Click="EditProject_Click" 
                                    Margin="0,0,10,0"
                                    Style="{StaticResource EditButtonStyle}"/>

                            <Button x:Name="DeleteProjectBtn" 
                                    Content="Удалить" 
                                    Click="DeleteProject_Click"
                                    Style="{StaticResource DeleteButtonStyle}"/>
                        </StackPanel>

                        <!-- Таблица проектов -->
                        <DataGrid x:Name="ProjectsGrid" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  Height="500"
                                  SelectionMode="Single">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID_проекта}" Width="50">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Название" Binding="{Binding Название_проекта}" Width="1.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Описание" Binding="{Binding Описание}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Начало" Binding="{Binding Дата_начала, StringFormat='dd.MM.yyyy'}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Завершение" Binding="{Binding Дата_завершения, StringFormat='dd.MM.yyyy'}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Статус" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusColor}"
                                                    CornerRadius="12"
                                                    Padding="8,4"
                                                    Margin="5,2">
                                                <TextBlock Text="{Binding Статус}"
                                                           Foreground="White"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Ответственный" Binding="{Binding Ответственный}" Width="1.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Бюджет" Binding="{Binding Бюджет, StringFormat='N2'}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== ПАНЕЛЬ ЗАДАЧ ==================== -->
            <Grid x:Name="TasksPanel" Visibility="Collapsed" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" MinHeight="250"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Задачи" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,10" 
                               HorizontalAlignment="Center"/>

                    <Border Grid.Row="1" 
                            Background="{DynamicResource BackgroundBrush}" 
                            CornerRadius="8" 
                            Padding="15" 
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Фильтры -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Поиск:" 
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="14" 
                                           VerticalAlignment="Center" 
                                           Margin="0,0,5,0"/>
                                <TextBox x:Name="TaskSearchBox" 
                                         Width="180" 
                                         Height="30" 
                                         TextChanged="TaskSearchBox_TextChanged" 
                                         Margin="0,0,10,0"/>

                                <TextBlock Text="Проект:"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="14" 
                                           VerticalAlignment="Center" 
                                           Margin="0,0,5,0"/>
                                <ComboBox x:Name="ProjectFilterBox"
                                         Width="200" 
                                         Height="30" 
                                         SelectionChanged="ProjectFilterBox_SelectionChanged" 
                                         DisplayMemberPath="Название_проекта" 
                                         SelectedValuePath="ID_проекта" 
                                         Margin="0,0,10,0"/>

                                <Button Content="Сброс фильтров" 
                                       Click="ResetFiltersBtn_Click"
                                       Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>

                            <!-- Кнопки действий -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="AddTaskBtn" 
                                       Content="Добавить задачу" 
                                       Click="AddTask_Click" 
                                       Margin="0,0,10,0"
                                       Style="{StaticResource AddButtonStyle}"/>
                                <Button x:Name="EditTaskBtn" 
                                       Content="Редактировать" 
                                       Click="EditTask_Click"
                                       Style="{StaticResource EditButtonStyle}"/>
                            </StackPanel>
                            <!-- Таблица задач -->
                            <DataGrid Grid.Row="2" 
                                     x:Name="TasksGrid" 
                                     AutoGenerateColumns="False" 
                                     IsReadOnly="True" 
                                     SelectionChanged="TasksGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding ID_задачи}" Width="40"/>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Название_задачи}" Width="*"/>
                                    <DataGridTextColumn Header="Проект" Binding="{Binding Название_проекта}" Width="*"/>
                                    <DataGridTextColumn Header="Ответственный" Binding="{Binding Ответственный}" Width="*"/>
                                    <DataGridTextColumn Header="Приоритет" Binding="{Binding Приоритет}" Width="Auto"/>
                                    <DataGridTemplateColumn Header="Статус" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Статус}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Срок" Binding="{Binding Срок_выполнения, StringFormat='dd.MM.yyyy'}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1" 
                             Height="5" 
                             HorizontalAlignment="Stretch" 
                             Background="{DynamicResource BorderBrush}"/>

                <!-- Детали задачи -->
                <Border Grid.Row="2" 
                        x:Name="TaskDetailsPanel" 
                        Margin="0,10,0,0" 
                        Visibility="Collapsed"
                        Background="{DynamicResource BackgroundBrush}" 
                        CornerRadius="8" 
                        Padding="15" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Детали задачи" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,0,0,15" 
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Название задачи:" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontWeight="SemiBold" 
                                   FontSize="14" 
                                   Margin="0,0,0,3"/>
                        <TextBlock x:Name="SelectedTaskName" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="16" 
                                   Margin="0,0,0,15" 
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Описание:" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontWeight="SemiBold" 
                                   FontSize="14" 
                                   Margin="0,0,0,3"/>
                        <TextBlock x:Name="SelectedTaskDescription" 
                                   Foreground="{DynamicResource DisabledForegroundBrush}"
                                   Margin="0,0,0,25" 
                                   TextWrapping="Wrap"/>

                        <Grid Margin="0,10,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="Подзадачи:" 
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontWeight="Bold" 
                                       FontSize="16" 
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1" 
                                   Content="Диаграмма Ганта" 
                                   Click="ShowGanttChart_Click"
                                   Style="{StaticResource SpecialButtonStyle}"/>
                        </Grid>

                        <DataGrid x:Name="SubtasksGrid" 
                                 AutoGenerateColumns="False" 
                                 IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding Название_подзадачи}" Width="*"/>
                                <DataGridTemplateColumn Header="Статус" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Статус}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Срок" Binding="{Binding Срок_выполнения, StringFormat='dd.MM.yyyy'}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== ПАНЕЛЬ СОБЫТИЙ ==================== -->
            <StackPanel x:Name="EventsPanel" Visibility="Collapsed" Margin="10">
                <TextBlock Text="События" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,10" 
                           HorizontalAlignment="Center"/>

                <Border Background="{DynamicResource BackgroundBrush}" 
                        CornerRadius="8" 
                        Padding="15" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="AddEventBtn" 
                                   Content="Добавить событие" 
                                   Click="AddEventBtn_Click" 
                                   Margin="0,0,10,0"
                                   Style="{StaticResource AddButtonStyle}"/>
                            <Button x:Name="EditEventBtn" 
                                   Content="Редактировать" 
                                   Click="EditEventBtn_Click" 
                                   Margin="0,0,10,0"
                                   Style="{StaticResource EditButtonStyle}"/>
                            <Button x:Name="DeleteEventBtn" 
                                   Content="Удалить" 
                                   Click="DeleteEventBtn_Click"
                                   Style="{StaticResource DeleteButtonStyle}"/>
                        </StackPanel>

                        <DataGrid x:Name="EventsGrid" 
                                 AutoGenerateColumns="False" 
                                 IsReadOnly="True" 
                                 Height="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID_события}" Width="40"/>
                                <DataGridTextColumn Header="Название" Binding="{Binding Название_события}" Width="*"/>
                                <DataGridTextColumn Header="Описание" Binding="{Binding Описание}" Width="*"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Дата_события, StringFormat='dd.MM.yyyy'}" Width="*"/>
                                <DataGridTextColumn Header="Проект" Binding="{Binding Название_проекта}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== ПАНЕЛЬ НАПОМИНАНИЙ ==================== -->
            <StackPanel x:Name="RemindersPanel" Visibility="Collapsed" Margin="10">
                <TextBlock Text="Напоминания" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,10" 
                           HorizontalAlignment="Center"/>

                <Border Background="{DynamicResource BackgroundBrush}" 
                        CornerRadius="8" 
                        Padding="15" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="AddReminderBtn" 
                                   Content="Добавить напоминание" 
                                   Click="AddReminderBtn_Click" 
                                   Margin="0,0,10,0"
                                   Style="{StaticResource AddButtonStyle}"/>
                            <Button x:Name="EditReminderBtn" 
                                   Content="Редактировать" 
                                   Click="EditReminderBtn_Click" 
                                   Margin="0,0,10,0"
                                   Style="{StaticResource EditButtonStyle}"/>
                            <Button x:Name="DeleteReminderBtn" 
                                   Content="Удалить" 
                                   Click="DeleteReminderBtn_Click"
                                   Style="{StaticResource DeleteButtonStyle}"/>
                        </StackPanel>

                        <DataGrid x:Name="RemindersGrid" 
                                 AutoGenerateColumns="False" 
                                 IsReadOnly="True" 
                                 Height="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID_напоминания}" Width="40"/>
                                <DataGridTextColumn Header="Текст" Binding="{Binding Текст_напоминания}" Width="*"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Дата_напоминания, StringFormat='dd.MM.yyyy'}" Width="100"/>
                                <DataGridTextColumn Header="Задача" Binding="{Binding Название_задачи}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== ПАНЕЛЬ ЗАМЕТОК ==================== -->
            <StackPanel x:Name="NotesPanel" Visibility="Collapsed" Margin="10">
                <TextBlock Text="Заметки" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,10" 
                           HorizontalAlignment="Center"/>

                <Border Background="{DynamicResource BackgroundBrush}" 
                        CornerRadius="8" 
                        Padding="15"
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="AddNoteBtn" 
                                   Content="Добавить заметку" 
                                   Click="AddNoteBtn_Click" 
                                   Margin="0,0,10,0"
                                   Style="{StaticResource AddButtonStyle}"/>
                            <Button x:Name="EditNoteBtn" 
                                   Content="Редактировать" 
                                   Click="EditNoteBtn_Click" 
                                   Margin="0,0,10,0"
                                   Style="{StaticResource EditButtonStyle}"/>
                            <Button x:Name="DeleteNoteBtn" 
                                   Content="Удалить" 
                                   Click="DeleteNoteBtn_Click"
                                   Style="{StaticResource DeleteButtonStyle}"/>
                        </StackPanel>

                        <DataGrid x:Name="NotesGrid" 
                                 AutoGenerateColumns="False" 
                                 IsReadOnly="True" 
                                 Height="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID_заметки}" Width="40"/>
                                <DataGridTextColumn Header="Текст" Binding="{Binding Текст_заметки}" Width="*"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Дата_создания, StringFormat='dd.MM.yyyy'}" Width="100"/>
                                <DataGridTextColumn Header="Задача" Binding="{Binding Название_задачи}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== ПАНЕЛЬ ЧАТА ==================== -->
            <StackPanel x:Name="ChatPanel" Visibility="Collapsed" Margin="10">
                <TextBlock Text="Чат" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,10" 
                           HorizontalAlignment="Center"/>

                <Border Background="{DynamicResource BackgroundBrush}" 
                        CornerRadius="8" 
                        Padding="15" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1">
                    <StackPanel>
                        <TextBox x:Name="ChatTextBox" 
                                IsReadOnly="True" 
                                VerticalScrollBarVisibility="Auto"
                                AcceptsReturn="True" 
                                TextWrapping="Wrap" 
                                Height="300"
                                Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="MessageTextBox" 
                                    Height="47" 
                                    TextWrapping="Wrap" 
                                    AcceptsReturn="True"
                                    VerticalAlignment="Center" 
                                    Margin="0,0,10,0" 
                                    Width="863"/>
                            <Button x:Name="SendButton" 
                                   Content="Отправить" 
                                   Height="50" 
                                   Width="120" 
                                   Click="SendButton_Click"
                                   Style="{StaticResource ActionButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== ПАНЕЛЬ ОТЧЁТОВ ==================== -->
            <ScrollViewer x:Name="ReportPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Отчёты и аналитика" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,20"/>

                    <!-- Панель управления экспортом -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="15" 
                            Margin="0,0,0,20" 
                            Background="{DynamicResource SecondaryBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="Экспорт отчётов" 
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="ExportTypeComboBox" 
                                         Width="200" 
                                         Margin="0,0,10,0">
                                    <ComboBoxItem Content="Проекты" IsSelected="True"/>
                                    <ComboBoxItem Content="Задачи"/>
                                </ComboBox>

                                <Button Content="📄 Экспорт в PDF" 
                                       Click="ExportToPDF_Click"
                                       Margin="0,0,10,0"
                                       Style="{StaticResource ExportPDFButtonStyle}"/>

                                <Button Content="📊 Экспорт в Excel" 
                                       Click="ExportToExcelNew_Click"
                                       Style="{StaticResource ExportExcelButtonStyle}"/>

                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Общая статистика -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="20" 
                            Margin="0,0,0,20" 
                            Background="{DynamicResource BackgroundBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Карточка 1: Всего проектов -->
                            <Border Grid.Column="0" 
                                   Background="#3498DB" 
                                   CornerRadius="8" 
                                   Padding="20" 
                                   Margin="5">
                                <StackPanel>
                                    <TextBlock Text="📁" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TotalProjectsCard" 
                                              Text="0" 
                                              FontSize="36" 
                                              FontWeight="Bold" 
                                              Foreground="White"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Всего проектов" 
                                              FontSize="14" 
                                              Foreground="White"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Карточка 2: Всего задач -->
                            <Border Grid.Column="1" 
                                   Background="#9B59B6" 
                                   CornerRadius="8" 
                                   Padding="20" 
                                   Margin="5">
                                <StackPanel>
                                    <TextBlock Text="📋" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TotalTasksCard" 
                                              Text="0" 
                                              FontSize="36" 
                                              FontWeight="Bold" 
                                              Foreground="White"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Всего задач" 
                                              FontSize="14" 
                                              Foreground="White"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Карточка 3: Завершённых задач -->
                            <Border Grid.Column="2" 
                                   Background="#27AE60" 
                                   CornerRadius="8" 
                                   Padding="20" 
                                   Margin="5">
                                <StackPanel>
                                    <TextBlock Text="✓" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="CompletedTasksCard" 
                                              Text="0" 
                                              FontSize="36" 
                                              FontWeight="Bold" 
                                              Foreground="White"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Завершено задач" 
                                              FontSize="14" 
                                              Foreground="White"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Карточка 4: Общий бюджет -->
                            <Border Grid.Column="3" 
                                   Background="#E67E22" 
                                   CornerRadius="8" 
                                   Padding="20" 
                                   Margin="5">
                                <StackPanel>
                                    <TextBlock Text="💰" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TotalBudgetCard" 
                                              Text="0 ₽" 
                                              FontSize="28" 
                                              FontWeight="Bold" 
                                              Foreground="White"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Общий бюджет" 
                                              FontSize="14" 
                                              Foreground="White"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Диаграммы в две колонки -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <!-- Диаграмма: Проекты по статусам -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" 
                                   BorderThickness="1" 
                                   CornerRadius="8" 
                                   Padding="15" 
                                   Margin="0,0,0,20" 
                                   Background="{DynamicResource BackgroundBrush}">
                                <StackPanel>
                                    <TextBlock Text="Проекты по статусам" 
                                              Foreground="{DynamicResource ForegroundBrush}"
                                              FontSize="16" 
                                              FontWeight="Bold" 
                                              Margin="0,0,0,15"/>
                                    <lvc:PieChart x:Name="ProjectsStatusPieChart" 
                                                 Height="300" 
                                                 LegendLocation="Bottom"/>
                                </StackPanel>
                            </Border>

                            <!-- Диаграмма: Задачи по приоритетам -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" 
                                   BorderThickness="1" 
                                   CornerRadius="8" 
                                   Padding="15" 
                                   Margin="0,0,0,20" 
                                   Background="{DynamicResource BackgroundBrush}">
                                <StackPanel>
                                    <TextBlock Text="Задачи по приоритетам" 
                                              Foreground="{DynamicResource ForegroundBrush}"
                                              FontSize="16" 
                                              FontWeight="Bold" 
                                              Margin="0,0,0,15"/>
                                    <lvc:PieChart x:Name="TasksPriorityPieChart" 
                                                 Height="300" 
                                                 LegendLocation="Bottom"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Правая колонка -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <!-- Диаграмма: Задачи по статусам -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" 
                                   BorderThickness="1" 
                                   CornerRadius="8" 
                                   Padding="15" 
                                   Margin="0,0,0,20" 
                                   Background="{DynamicResource BackgroundBrush}">
                                <StackPanel>
                                    <TextBlock Text="Задачи по статусам" 
                                              Foreground="{DynamicResource ForegroundBrush}"
                                              FontSize="16" 
                                              FontWeight="Bold" 
                                              Margin="0,0,0,15"/>
                                    <lvc:CartesianChart x:Name="TasksStatusBarChart" 
                                                       Height="300">
                                        <lvc:CartesianChart.AxisX>
                                            <lvc:Axis Labels="{Binding}" FontSize="12"/>
                                        </lvc:CartesianChart.AxisX>
                                        <lvc:CartesianChart.AxisY>
                                            <lvc:Axis Title="Количество" FontSize="12"/>
                                        </lvc:CartesianChart.AxisY>
                                    </lvc:CartesianChart>
                                </StackPanel>
                            </Border>

                            <!-- Диаграмма: Бюджеты проектов -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" 
                                   BorderThickness="1" 
                                   CornerRadius="8" 
                                   Padding="15" 
                                   Margin="0,0,0,20" 
                                   Background="{DynamicResource BackgroundBrush}">
                                <StackPanel>
                                    <TextBlock Text="ТОП-5 проектов по бюджету" 
                                              Foreground="{DynamicResource ForegroundBrush}"
                                              FontSize="16" 
                                              FontWeight="Bold" 
                                              Margin="0,0,0,15"/>
                                    <lvc:CartesianChart x:Name="ProjectsBudgetBarChart" 
                                                       Height="300">
                                        <lvc:CartesianChart.AxisX>
                                            <lvc:Axis Labels="{Binding}" FontSize="10"/>
                                        </lvc:CartesianChart.AxisX>
                                        <lvc:CartesianChart.AxisY>
                                            <lvc:Axis Title="Бюджет (₽)" FontSize="12" LabelFormatter="{Binding}"/>
                                        </lvc:CartesianChart.AxisY>
                                    </lvc:CartesianChart>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Анализ использования ресурсов -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" 
                           BorderThickness="1" 
                           CornerRadius="8" 
                           Padding="15" 
                           Margin="0,0,0,20" 
                           Background="{DynamicResource BackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="📦 Использование ресурсов" 
                                      Foreground="{DynamicResource ForegroundBrush}"
                                      FontSize="16" 
                                      FontWeight="Bold" 
                                      Margin="0,0,0,15"/>
                            <DataGrid x:Name="ResourcesUsageGrid" 
                                     AutoGenerateColumns="False" 
                                     IsReadOnly="True"
                                     Height="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ресурс" Binding="{Binding Название}" Width="*"/>
                                    <DataGridTextColumn Header="Тип" Binding="{Binding Тип}" Width="150"/>
                                    <DataGridTextColumn Header="Количество" Binding="{Binding Количество}" Width="100"/>
                                    <DataGridTextColumn Header="Используется в проектах" Binding="{Binding ПроектовИспользуется}" Width="180"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Просроченные задачи -->
                    <Border BorderBrush="#E74C3C" 
                           BorderThickness="2" 
                           CornerRadius="8" 
                           Padding="15" 
                           Background="#FFEBEE">
                        <StackPanel>
                            <TextBlock Text="⚠️ Просроченные задачи" 
                                      FontSize="16" 
                                      FontWeight="Bold" 
                                      Foreground="#C0392B"
                                      Margin="0,0,0,15"/>
                            <DataGrid x:Name="OverdueTasksGrid" 
                                     AutoGenerateColumns="False" 
                                     IsReadOnly="True"
                                     Height="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding ID_задачи}" Width="50"/>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Название_задачи}" Width="*"/>
                                    <DataGridTextColumn Header="Проект" Binding="{Binding Название_проекта}" Width="200"/>
                                    <DataGridTextColumn Header="Ответственный" Binding="{Binding Ответственный}" Width="200"/>
                                    <DataGridTextColumn Header="Просрочено на (дней)" Binding="{Binding ДнейПросрочено}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== ПАНЕЛЬ ПОЛЬЗОВАТЕЛЕЙ ==================== -->
            <StackPanel x:Name="UsersPanel" Visibility="Collapsed" Margin="10">
                <TextBlock Text="Пользователи" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,10" 
                           HorizontalAlignment="Center"/>

                <Border Background="{DynamicResource BackgroundBrush}" 
                        CornerRadius="8" 
                        Padding="15" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="AddUserBtn" 
                                   Content="Добавить пользователя" 
                                   Width="200"
                                   Click="AddUserBtn_Click"
                                   Margin="0,0,10,0"
                                   Style="{StaticResource AddButtonStyle}"/>
                            <Button x:Name="EditUserBtn" 
                                   Content="Редактировать" 
                                   Click="EditUserBtn_Click" 
                                   Width="150"
                                   Margin="0,0,10,0"
                                   Style="{StaticResource EditButtonStyle}"/>
                            <Button x:Name="DeleteUserBtn" 
                                   Content="Удалить" 
                                   Width="150"
                                   Click="DeleteUserBtn_Click"
                                   Style="{StaticResource DeleteButtonStyle}"/>
                        </StackPanel>

                        <DataGrid x:Name="UsersGrid" 
                                 AutoGenerateColumns="False" 
                                 IsReadOnly="True" 
                                 Height="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                                <DataGridTextColumn Header="Имя" Binding="{Binding Имя}" Width="*"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                                <DataGridTextColumn Header="Роль" Binding="{Binding Роль}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== ПАНЕЛЬ УВЕДОМЛЕНИЙ ==================== -->
            <StackPanel x:Name="NotificationsPanel" Visibility="Collapsed" Margin="10">
                <TextBlock Text="Уведомления" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,20"/>

                <!-- Панель управления -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Отметить все как прочитанные" 
                           Click="MarkAllAsRead_Click"
                           Margin="0,0,10,0"
                           Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="Очистить прочитанные" 
                           Click="ClearReadNotifications_Click"
                           Margin="0,0,10,0"
                           Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="Обновить" 
                           Click="RefreshNotifications_Click"
                           Style="{StaticResource ActionButtonStyle}"/>
                </StackPanel>

                <!-- Фильтры -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Фильтр:" 
                              Foreground="{DynamicResource ForegroundBrush}"
                              VerticalAlignment="Center" 
                              Margin="0,0,10,0"/>
                    <RadioButton x:Name="AllNotificationsRadio" 
                                Content="Все" 
                                IsChecked="True"
                                GroupName="NotificationFilter"
                                Checked="NotificationFilter_Changed"
                                Margin="0,0,15,0"/>
                    <RadioButton x:Name="UnreadNotificationsRadio" 
                                Content="Непрочитанные" 
                                GroupName="NotificationFilter"
                                Checked="NotificationFilter_Changed"
                                Margin="0,0,15,0"/>

                    <TextBlock Text="Тип:" 
                              Foreground="{DynamicResource ForegroundBrush}"
                              VerticalAlignment="Center" 
                              Margin="20,0,10,0"/>
                    <ComboBox x:Name="NotificationTypeFilter" 
                             Width="150"
                             SelectionChanged="NotificationFilter_Changed">
                        <ComboBoxItem Content="Все типы" IsSelected="True"/>
                        <ComboBoxItem Content="Задача"/>
                        <ComboBoxItem Content="Проект"/>
                        <ComboBoxItem Content="Напоминание"/>
                        <ComboBoxItem Content="Событие"/>
                        <ComboBoxItem Content="Система"/>
                    </ComboBox>
                </StackPanel>

                <!-- Список уведомлений -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="500">
                    <ItemsControl x:Name="NotificationsListBox">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" 
                                       BorderThickness="1" 
                                       CornerRadius="5" 
                                       Padding="10" 
                                       Margin="0,0,0,5"
                                       Background="{Binding BackgroundColor}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                  Text="{Binding ТипИконка}" 
                                                  FontSize="24"
                                                  VerticalAlignment="Top"
                                                  Margin="0,0,10,0"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Заголовок}" 
                                                      FontWeight="Bold" 
                                                      FontSize="15"
                                                      Foreground="White"
                                                      TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Текст}" 
                                                      FontSize="13"
                                                      Foreground="#DDDDDD"
                                                      TextWrapping="Wrap"
                                                      Margin="0,5,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding ВремяС_момента_создания}" 
                                                          FontSize="11"
                                                          Foreground="#AAAAAA"/>
                                                <TextBlock Text=" • " 
                                                          FontSize="11"
                                                          Foreground="#AAAAAA"
                                                          Margin="5,0"/>
                                                <TextBlock Text="{Binding Приоритет}" 
                                                          FontSize="11"
                                                          Foreground="{Binding ПриоритетЦвет}"
                                                          FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" 
                                                   Orientation="Horizontal"
                                                   VerticalAlignment="Center">
                                            <Button Content="✓" 
                                                   ToolTip="Отметить как прочитанное"
                                                   Width="30" 
                                                   Height="30"
                                                   Margin="5,0"
                                                   Click="MarkAsRead_Click"
                                                   Tag="{Binding ID}"
                                                   Visibility="{Binding ReadButtonVisibility}"/>
                                            <Button Content="🗑" 
                                                   ToolTip="Удалить"
                                                   Width="30" 
                                                   Height="30"
                                                   Click="DeleteNotification_Click"
                                                   Tag="{Binding ID}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="NoNotificationsText"
                          Text="У вас пока нет уведомлений"
                          FontSize="16"
                          Foreground="{DynamicResource DisabledForegroundBrush}"
                          HorizontalAlignment="Center"
                          Margin="0,50,0,0"
                          Visibility="Collapsed"/>
            </StackPanel>

        </Grid>
    </DockPanel>
</Window>