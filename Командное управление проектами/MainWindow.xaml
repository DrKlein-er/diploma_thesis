<Window x:Class="Командное_управление_проектами.MainWindow"
        Icon="pack://application:,,,/Resources/checklist.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dxsch="http://schemas.devexpress.com/winfx/2008/xaml/scheduler"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:local="clr-namespace:Командное_управление_проектами"
        xmlns:converters="clr-namespace:Командное_управление_проектами.Converters"
        xmlns:h="clr-namespace:Командное_управление_проектами.Helpers"
        mc:Ignorable="d"
        Title="Система управления проектами" Height="850" Width="1500" WindowStartupLocation="CenterScreen"
        WindowState="Maximized" Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <h:NoteColorToBrushConverter x:Key="NoteColorToBrush"/>
        <h:EventTypeToBrushConverter x:Key="EventTypeToBrush"/>
        <h:EventTypeToBackgroundBrushConverter x:Key="EventTypeToBgBrush"/>
        <h:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

        <!-- Градиент для верхней панели - адаптируется к теме -->
        <LinearGradientBrush x:Key="TopPanelBackground" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{Binding Source={StaticResource AccentBrush}, Path=Color}" Offset="0"/>
            <GradientStop Color="#005F99" Offset="1"/>
        </LinearGradientBrush>

        <!-- ==================== СТИЛИ КНОПОК ==================== -->

        <!-- Стиль для кнопки "Выход" -->
        <Style x:Key="ExitButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B71C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#9A0007"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок действий (Зелёная - Добавить) -->
        <Style x:Key="AddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45A049"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3D8B40"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок редактирования (Жёлтая) -->
        <Style x:Key="EditButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFB300"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFA000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок удаления (Красная) -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F44336"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E53935"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D32F2F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок действий общего назначения (Синяя) -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004578"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок специального назначения (Фиолетовая - Диаграмма Ганта и т.д.) -->
        <Style x:Key="SpecialButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#5C6BC0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="4" 
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5461B5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4A56A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportPDFButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="4" 
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D43F31"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C0392B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок экспорта Excel (Зелёная) -->
        <Style x:Key="ExportExcelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="4" 
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#229954"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E8449"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль чипа-фильтра по типу события -->
        <Style x:Key="FilterChipStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="Foreground" Value="{StaticResource MetaTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="chipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="{StaticResource EventMeetingBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource EventMeetingBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="{StaticResource EventMeetingBrush}"/>
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="{StaticResource EventMeetingBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль кнопки-иконки в футере карточки (28x28, серая) -->
        <Style x:Key="CardIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MetaTextBrush}"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="iconBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="iconBorder" Property="BorderBrush" Value="{StaticResource EventMeetingBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource EventMeetingBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка-иконка «Удалить» — отдельный стиль с красным hover -->
        <Style x:Key="CardIconDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource CardIconButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#E53935"/>
                    <Setter Property="BorderBrush" Value="#E53935"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль самой карточки события: фон, скругление, hover-тень -->
        <Style x:Key="EventCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Width" Value="320"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#2196F3"
                                              BlurRadius="18"
                                              ShadowDepth="2"
                                              Opacity="0.18"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль тоггл-кнопок фильтра календаря -->
        <Style x:Key="CalendarFilterToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="tb"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tb" Property="Background"
                                        Value="{StaticResource EventMeetingBrush}"/>
                                <Setter TargetName="tb" Property="BorderBrush"
                                        Value="{StaticResource EventMeetingBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tb" Property="BorderBrush"
                                        Value="{StaticResource EventMeetingBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel Background="{DynamicResource BackgroundBrush}">
        <!-- Верхняя панель -->
        <Border DockPanel.Dock="Top" 
                Background="{StaticResource TopPanelBackground}" 
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Выход" 
                        Style="{StaticResource ExitButtonStyle}" 
                        Click="Logout_Click" 
                        Grid.Column="1" 
                        Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- Боковая панель навигации -->
        <StackPanel x:Name="MenuPanel" 
            DockPanel.Dock="Left" 
            Width="220" 
            Background="{DynamicResource MenuBackgroundBrush}">

            <!-- Заголовок панели -->
            <Border Background="{DynamicResource AccentBrush}" 
            Padding="15" 
            Margin="5,5,5,15">
                <StackPanel>
                    <TextBlock Text="Навигация" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Button x:Name="CalendarButton" 
            Content="Календарь" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowCalendar"/>
            <Button x:Name="ProjectsButton" 
            Content="Проекты" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowProjects"/>
            <Button x:Name="TasksButton" 
            Content="Задачи" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowTasks"/>
            <Button x:Name="EventsButton" 
            Content="События" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowEvents"/>
            <Button x:Name="RemindersButton" 
            Content="Напоминания" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowReminders"/>
            <Button x:Name="NotesButton" 
            Content="Заметки" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowNotes"/>
            <Button x:Name="NotificationsButton" 
            Content="Уведомления" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowNotifications"/>
            <Button x:Name="ChatButton" 
            Content="Чат" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowChat"/>
            <Button x:Name="ReportsButton" 
            Content="Отчёты" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowReports" 
            Visibility="Collapsed"/>
            <Button x:Name="UsersButton" 
            Content="Пользователи" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowUsers" 
            Visibility="Collapsed"/>
            <Button x:Name="HistoryButton" 
            Content="История изменений" 
            Style="{StaticResource MenuButtonStyle}" 
            Click="ShowHistory" 
            Visibility="Collapsed"/>

            <!-- Разделитель -->
            <Border Height="1" 
            Background="{DynamicResource BorderBrush}" 
            Margin="10,10"/>

            <Button x:Name="ProfileButton" 
            Content="Профиль" 
            Click="ShowProfile" 
            Style="{StaticResource MenuButtonStyle}"/>
        </StackPanel>

        <!-- Центральная зона -->
        <Grid x:Name="MainContent" Background="{DynamicResource BackgroundBrush}">

            <!-- ==================== ПАНЕЛЬ КАЛЕНДАРЯ ==================== -->
            <Grid x:Name="CalendarPanel" Visibility="Visible" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Этап 2: Шапка — навигация слева, фильтры справа -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="TodayButton"
                                Content="Сегодня"
                                Click="TodayButton_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="0,0,8,0"/>
                        <Button x:Name="PrevMonthButton"
                                Content="◄"
                                Click="PrevMonthButton_Click"
                                Style="{StaticResource MenuButtonStyle}"
                                Width="36" Height="36"/>
                        <TextBlock x:Name="MonthYearLabel"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="12,0"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="NextMonthButton"
                                Content="►"
                                Click="NextMonthButton_Click"
                                Style="{StaticResource MenuButtonStyle}"
                                Width="36" Height="36"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="ToggleEvents"
                                      Content="✔ События"
                                      IsChecked="True"
                                      Click="CalendarFilter_Changed"
                                      Style="{StaticResource CalendarFilterToggleStyle}"/>
                        <ToggleButton x:Name="ToggleTasks"
                                      Content="✔ Задачи"
                                      IsChecked="True"
                                      Click="CalendarFilter_Changed"
                                      Style="{StaticResource CalendarFilterToggleStyle}"/>
                        <ToggleButton x:Name="ToggleReminders"
                                      Content="✔ Напоминания"
                                      IsChecked="True"
                                      Click="CalendarFilter_Changed"
                                      Style="{StaticResource CalendarFilterToggleStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Этап 3: Заголовки дней недели -->
                <Grid Grid.Row="1" Margin="2,0,2,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ПН" TextAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" Opacity="0.6"/>
                    <TextBlock Grid.Column="1" Text="ВТ" TextAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" Opacity="0.6"/>
                    <TextBlock Grid.Column="2" Text="СР" TextAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" Opacity="0.6"/>
                    <TextBlock Grid.Column="3" Text="ЧТ" TextAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" Opacity="0.6"/>
                    <TextBlock Grid.Column="4" Text="ПТ" TextAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" Opacity="0.6"/>
                    <TextBlock Grid.Column="5" Text="СБ" TextAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" Opacity="0.6"/>
                    <TextBlock Grid.Column="6" Text="ВС" TextAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" Opacity="0.6"/>
                </Grid>

                <!-- Этапы 4-5: Сетка ячеек -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BackgroundBrush}"
                        CornerRadius="8"
                        Padding="4"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CalendarItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ==================== ПАНЕЛЬ ПРОЕКТОВ ==================== -->
            <StackPanel x:Name="ProjectsPanel" Visibility="Collapsed" Margin="10">
                <TextBlock Text="Проекты" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,20" 
                           HorizontalAlignment="Center"/>

                <Border Background="{DynamicResource BackgroundBrush}" 
                        CornerRadius="8" 
                        Padding="15" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1">
                    <StackPanel>
                        <!-- Фильтры -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Название:" 
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="14" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"
                                     x:Name="ProjectNameSearchBox" 
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     TextChanged="ProjectFilters_Changed" 
                                     Margin="0,0,20,0"/>

                            <TextBlock Grid.Column="2"
                                       Text="Ответственный:" 
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="14" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0"/>
                            <TextBox Grid.Column="3"
                                     x:Name="ProjectResponsibleSearchBox" 
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     TextChanged="ProjectFilters_Changed" 
                                     Margin="0,0,20,0"/>

                            <TextBlock Grid.Column="4"
                                       Text="Период:" 
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="14" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="0,0,20,0">
                                <DatePicker x:Name="ProjectStartDatePicker" 
                                           SelectedDateChanged="ProjectFilters_Changed" 
                                           Width="120" 
                                           Height="32"
                                           Margin="0,0,5,0"/>
                                <TextBlock Text="до" 
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           VerticalAlignment="Center" 
                                           Margin="5,0"/>
                                <DatePicker x:Name="ProjectEndDatePicker" 
                                           SelectedDateChanged="ProjectFilters_Changed" 
                                           Width="120" 
                                           Height="32"
                                           Margin="5,0,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="6"
                                    Content="Сброс фильтров" 
                                    Click="ResetProjectFiltersBtn_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                        </Grid>

                        <!-- Кнопки действий -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button x:Name="AddProjectBtn" 
                                    Content="Добавить проект" 
                                    Click="AddProject_Click" 
                                    Margin="0,0,10,0"
                                    Style="{StaticResource AddButtonStyle}"/>

                            <Button x:Name="EditProjectBtn" 
                                    Content="Подробнее" 
                                    Click="EditProject_Click" 
                                    Margin="0,0,10,0"
                                    Style="{StaticResource EditButtonStyle}"/>

                            <Button x:Name="DeleteProjectBtn" 
                                    Content="Удалить" 
                                    Click="DeleteProject_Click"
                                    Style="{StaticResource DeleteButtonStyle}"/>
                        </StackPanel>

                        <!-- Таблица проектов -->
                        <DataGrid x:Name="ProjectsGrid" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  Height="500"
                                  SelectionMode="Single">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID_проекта}" Width="50">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Название" Binding="{Binding Название_проекта}" Width="1.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Описание" Binding="{Binding Описание}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Начало" Binding="{Binding Дата_начала, StringFormat='dd.MM.yyyy'}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Завершение" Binding="{Binding Дата_завершения, StringFormat='dd.MM.yyyy'}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Статус" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusColor}"
                                                    CornerRadius="12"
                                                    Padding="8,4"
                                                    Margin="5,2">
                                                <TextBlock Text="{Binding Статус}"
                                                           Foreground="White"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Ответственный" Binding="{Binding Ответственный}" Width="1.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Бюджет" Binding="{Binding Бюджет, StringFormat='N2'}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== ПАНЕЛЬ ЗАДАЧ ==================== -->
            <Grid x:Name="TasksPanel" Visibility="Collapsed" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" MinHeight="250"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Задачи" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,10" 
                               HorizontalAlignment="Center"/>

                    <Border Grid.Row="1" 
                            Background="{DynamicResource BackgroundBrush}" 
                            CornerRadius="8" 
                            Padding="15" 
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Фильтры -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Поиск:" 
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="14" 
                                           VerticalAlignment="Center" 
                                           Margin="0,0,5,0"/>
                                <TextBox x:Name="TaskSearchBox" 
                                         Width="180" 
                                         Height="30" 
                                         TextChanged="TaskSearchBox_TextChanged" 
                                         Margin="0,0,10,0"/>

                                <TextBlock Text="Проект:"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="14" 
                                           VerticalAlignment="Center" 
                                           Margin="0,0,5,0"/>
                                <ComboBox x:Name="ProjectFilterBox"
                                         Width="200" 
                                         Height="30" 
                                         SelectionChanged="ProjectFilterBox_SelectionChanged" 
                                         DisplayMemberPath="Название_проекта" 
                                         SelectedValuePath="ID_проекта" 
                                         Margin="0,0,10,0"/>

                                <Button Content="Сброс фильтров" 
                                       Click="ResetFiltersBtn_Click"
                                       Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>

                            <!-- Кнопки действий -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="AddTaskBtn" 
                                       Content="Добавить задачу" 
                                       Click="AddTask_Click" 
                                       Margin="0,0,10,0"
                                       Style="{StaticResource AddButtonStyle}"/>
                                <Button x:Name="EditTaskBtn" 
                                       Content="Подробнее" 
                                       Click="EditTask_Click"
                                       Style="{StaticResource EditButtonStyle}"/>
                            </StackPanel>
                            <!-- Таблица задач -->
                            <DataGrid Grid.Row="2" 
                                     x:Name="TasksGrid" 
                                     AutoGenerateColumns="False" 
                                     IsReadOnly="True" 
                                     SelectionChanged="TasksGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding ID_задачи}" Width="40"/>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Название_задачи}" Width="*"/>
                                    <DataGridTextColumn Header="Проект" Binding="{Binding Название_проекта}" Width="*"/>
                                    <DataGridTextColumn Header="Ответственный" Binding="{Binding Ответственный}" Width="*"/>
                                    <DataGridTextColumn Header="Приоритет" Binding="{Binding Приоритет}" Width="Auto"/>
                                    <DataGridTemplateColumn Header="Статус" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Статус}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Дата начала" Binding="{Binding Дата_начала, StringFormat='dd.MM.yyyy'}" Width="Auto"/>
                                    <DataGridTextColumn Header="Дата завершения" Binding="{Binding Дата_завершения, StringFormat='dd.MM.yyyy'}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1" 
                             Height="5" 
                             HorizontalAlignment="Stretch" 
                             Background="{DynamicResource BorderBrush}"/>

                <!-- Детали задачи -->
                <Border Grid.Row="2" 
                        x:Name="TaskDetailsPanel" 
                        Margin="0,10,0,0" 
                        Visibility="Collapsed"
                        Background="{DynamicResource BackgroundBrush}" 
                        CornerRadius="8" 
                        Padding="15" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Детали задачи" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,0,0,15" 
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Название задачи:" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontWeight="SemiBold" 
                                   FontSize="14" 
                                   Margin="0,0,0,3"/>
                        <TextBlock x:Name="SelectedTaskName" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="16" 
                                   Margin="0,0,0,15" 
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Описание:" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontWeight="SemiBold" 
                                   FontSize="14" 
                                   Margin="0,0,0,3"/>
                        <TextBlock x:Name="SelectedTaskDescription" 
                                   Foreground="{DynamicResource DisabledForegroundBrush}"
                                   Margin="0,0,0,25" 
                                   TextWrapping="Wrap"/>

                        <Grid Margin="0,10,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="Подзадачи:" 
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontWeight="Bold" 
                                       FontSize="16" 
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1" 
                                   Content="Диаграмма Ганта" 
                                   Click="ShowGanttChart_Click"
                                   Style="{StaticResource SpecialButtonStyle}"/>
                        </Grid>

                        <DataGrid x:Name="SubtasksGrid" 
                                 AutoGenerateColumns="False" 
                                 IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding Название_подзадачи}" Width="*"/>
                                <DataGridTemplateColumn Header="Статус" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Статус}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Срок" Binding="{Binding Срок_выполнения, StringFormat='dd.MM.yyyy'}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== ПАНЕЛЬ СОБЫТИЙ ==================== -->
            <StackPanel x:Name="EventsPanel" Visibility="Collapsed" Margin="20">

                <!-- ───── Шапка: заголовок + кнопка «Добавить» ───── -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="События"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            x:Name="AddEventBtn"
                            Click="AddEventBtn_Click"
                            Background="{StaticResource EventMeetingBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="18,8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="+"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Margin="0,-2,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Добавить событие"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>



                <!-- ───── Фильтры по типу + поле поиска ───── -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Чипы-фильтры (RadioButton с группой) -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="Тип:"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MetaTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <RadioButton x:Name="ChipAll"
                                     Content="Все"
                                     GroupName="EventTypeFilter"
                                     IsChecked="True"
                                     Style="{StaticResource FilterChipStyle}"
                                     Checked="EventTypeFilter_Changed"/>
                        <RadioButton x:Name="ChipMeeting"
                                     Content="Встреча"
                                     GroupName="EventTypeFilter"
                                     Style="{StaticResource FilterChipStyle}"
                                     Checked="EventTypeFilter_Changed"/>
                        <RadioButton x:Name="ChipDeadline"
                                     Content="Дедлайн"
                                     GroupName="EventTypeFilter"
                                     Style="{StaticResource FilterChipStyle}"
                                     Checked="EventTypeFilter_Changed"/>
                        <RadioButton x:Name="ChipPresent"
                                     Content="Презентация"
                                     GroupName="EventTypeFilter"
                                     Style="{StaticResource FilterChipStyle}"
                                     Checked="EventTypeFilter_Changed"/>
                        <RadioButton x:Name="ChipPersonal"
                                     Content="Личное"
                                     GroupName="EventTypeFilter"
                                     Style="{StaticResource FilterChipStyle}"
                                     Checked="EventTypeFilter_Changed"/>
                    </StackPanel>

                    <!-- Поле поиска -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Поиск:"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MetaTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBox x:Name="EventSearchBox"
                                 Width="240"
                                 Height="32"
                                 FontSize="13"
                                 Padding="10,5"
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource TextBoxBackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 TextChanged="EventSearchBox_TextChanged"/>
                    </StackPanel>
                </Grid>

                <!-- ───── Счётчик отфильтрованных событий ───── -->
                <TextBlock x:Name="EventsCountLabel"
                           Text="0 событий"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MetaTextBrush}"
                           Margin="0,0,0,10"/>
                <!-- ───── Контейнер карточек с прокруткой ───── -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="600">

                    <!-- Empty state — если карточек нет -->
                    <Grid>
                        <StackPanel x:Name="EventsEmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,60,0,0"
                                    Visibility="Collapsed">
                            <Border Background="{StaticResource EventMeetingBgBrush}"
                                    Width="64" Height="64"
                                    CornerRadius="32"
                                    Margin="0,0,0,14">
                                <TextBlock Text="📅"
                                           FontSize="32"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Нет событий"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MetaTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Попробуйте изменить фильтр или поисковый запрос"
                                       FontSize="13"
                                       Foreground="{StaticResource MetaTextBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Сетка карточек -->
                        <ItemsControl x:Name="EventsItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource EventCardStyle}">
                                        <Border.Clip>
                                            <!-- Чтобы цветная полоска не вылезала за скруглённые углы -->
                                            <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,320,260"/>
                                        </Border.Clip>
                                        <StackPanel>
                                            <!-- Цветная полоска сверху (4px) -->
                                            <Border Height="4"
                                                    Background="{Binding Тип_события, Converter={StaticResource EventTypeToBrush}}"/>

                                            <!-- Тело карточки -->
                                            <StackPanel Margin="16,14,16,14">

                                                <!-- Верхний ряд: бейдж типа + ID -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Бейдж типа: цветная капсула с точкой -->
                                                    <Border Grid.Column="0"
                                                            HorizontalAlignment="Left"
                                                            Background="{Binding Тип_события, Converter={StaticResource EventTypeToBgBrush}}"
                                                            CornerRadius="20"
                                                            Padding="11,3">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7"
                                                                     Fill="{Binding Тип_события, Converter={StaticResource EventTypeToBrush}}"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,5,0"/>
                                                            <TextBlock Text="{Binding Тип_события}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding Тип_события, Converter={StaticResource EventTypeToBrush}}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- ID -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ID_события, StringFormat='#{0}'}"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Foreground="{StaticResource MetaIconBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Название события -->
                                                <TextBlock Text="{Binding Название_события}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,10"/>

                                                <!-- Метаданные -->
                                                <StackPanel>
                                                    <!-- Дата -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="📅"
                                                                   FontSize="13"
                                                                   Margin="0,0,7,0"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Дата_начала, StringFormat='dd.MM.yyyy'}"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource MetaTextBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Время (всегда показываем) -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="🕒"
                                                                   FontSize="13"
                                                                   Margin="0,0,7,0"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ВремяОтображение}"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource MetaTextBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Место (скрывается, если пусто) -->
                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="0,0,0,4"
                                                                Visibility="{Binding Место_проведения, Converter={StaticResource StringToVisibility}}">
                                                        <TextBlock Text="📍"
                                                                   FontSize="13"
                                                                   Margin="0,0,7,0"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Место_проведения}"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource MetaTextBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Задача (скрывается, если пусто) -->
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding Название_задачи, Converter={StaticResource StringToVisibility}}">
                                                        <TextBlock Text="✓"
                                                                   FontSize="13"
                                                                   Margin="0,0,7,0"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Название_задачи}"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource MetaTextBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Футер: проект + кнопки -->
                                            <Border Background="{StaticResource CardFooterBgBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    Padding="14,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Тег проекта -->
                                                    <Border Grid.Column="0"
                                                            HorizontalAlignment="Left"
                                                            Background="{DynamicResource BackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="9,2"
                                                            MaxWidth="180">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📁"
                                                                       FontSize="11"
                                                                       Margin="0,0,5,0"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ПроектОтображение}"
                                                                       FontSize="12"
                                                                       FontWeight="Medium"
                                                                       Foreground="{StaticResource MetaTextBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Кнопки-иконки -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Style="{StaticResource CardIconButtonStyle}"
                                                                Tag="{Binding ID_события}"
                                                                Click="EditEventCard_Click"
                                                                ToolTip="Редактировать">
                                                            <TextBlock Text="✏"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center"/>
                                                        </Button>
                                                        <Button Style="{StaticResource CardIconDeleteButtonStyle}"
                                                                Tag="{Binding ID_события}"
                                                                Click="DeleteEventCard_Click"
                                                                ToolTip="Удалить">
                                                            <TextBlock Text="🗑"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>

            </StackPanel>

            <!-- ==================== ПАНЕЛЬ НАПОМИНАНИЙ ==================== -->
            <StackPanel x:Name="RemindersPanel" Visibility="Collapsed" Margin="10">
                <TextBlock Text="Напоминания" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,10" 
                           HorizontalAlignment="Center"/>

                <Border Background="{DynamicResource BackgroundBrush}" 
                        CornerRadius="8" 
                        Padding="15" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="AddReminderBtn" 
                                   Content="Добавить напоминание" 
                                   Click="AddReminderBtn_Click" 
                                   Margin="0,0,10,0"
                                   Style="{StaticResource AddButtonStyle}"/>
                            <Button x:Name="EditReminderBtn" 
                                   Content="Редактировать" 
                                   Click="EditReminderBtn_Click" 
                                   Margin="0,0,10,0"
                                   Style="{StaticResource EditButtonStyle}"/>
                            <Button x:Name="DeleteReminderBtn" 
                                   Content="Удалить" 
                                   Click="DeleteReminderBtn_Click"
                                   Style="{StaticResource DeleteButtonStyle}"/>
                        </StackPanel>

                        <DataGrid x:Name="RemindersGrid" 
                                 AutoGenerateColumns="False" 
                                 IsReadOnly="True" 
                                 Height="400">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID_напоминания}" Width="40"/>
                                <DataGridTextColumn Header="Текст" Binding="{Binding Текст_напоминания}" Width="2*"/>
                                <DataGridTextColumn Header="Когда" Binding="{Binding Дата_напоминания, StringFormat='dd.MM.yyyy HH:mm'}" Width="140"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Статус}" Width="100"/>
                                <DataGridTextColumn Header="Приоритет" Binding="{Binding Приоритет}" Width="100"/>
                                <DataGridTextColumn Header="Задача" Binding="{Binding Название_задачи}" Width="*"/>
                                <DataGridTemplateColumn Header="Действия" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="⏰ +15 мин" 
                                                        Click="SnoozeReminder15_Click"
                                                        Tag="{Binding ID_напоминания}"
                                                        Margin="2"
                                                        Padding="6,2"
                                                        ToolTip="Отложить на 15 минут"/>
                                                <Button Content="⏰ +1 ч" 
                                                        Click="SnoozeReminder60_Click"
                                                        Tag="{Binding ID_напоминания}"
                                                        Margin="2"
                                                        Padding="6,2"
                                                        ToolTip="Отложить на 1 час"/>
                                                <Button Content="✓"
                                                        Click="MarkReminderDone_Click"
                                                        Tag="{Binding ID_напоминания}"
                                                        Margin="2"
                                                        Padding="6,2"
                                                        ToolTip="Отметить как выполненное"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== ПАНЕЛЬ ЗАМЕТОК ==================== -->
            <StackPanel x:Name="NotesPanel" Visibility="Collapsed" Margin="10">
                <TextBlock Text="Заметки" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,10" 
                           HorizontalAlignment="Center"/>

                <Border Background="{DynamicResource BackgroundBrush}" 
                        CornerRadius="8" 
                        Padding="15"
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="AddNoteBtn" 
                                   Content="Добавить заметку" 
                                   Click="AddNoteBtn_Click" 
                                   Margin="0,0,10,0"
                                   Style="{StaticResource AddButtonStyle}"/>
                            <Button x:Name="EditNoteBtn" 
                                   Content="Редактировать" 
                                   Click="EditNoteBtn_Click" 
                                   Margin="0,0,10,0"
                                   Style="{StaticResource EditButtonStyle}"/>
                            <Button x:Name="DeleteNoteBtn" 
                                   Content="Удалить" 
                                   Click="DeleteNoteBtn_Click"
                                   Style="{StaticResource DeleteButtonStyle}"/>
                        </StackPanel>

                        <DataGrid x:Name="NotesGrid" 
                                 AutoGenerateColumns="False" 
                                 IsReadOnly="True" 
                                 Height="400">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="{Binding Цвет, Converter={StaticResource NoteColorToBrush}}"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="📌" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="📌"
                                                       FontSize="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="Black">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Закреплена}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID_заметки}" Width="40"/>
                                <DataGridTextColumn Header="Заголовок" Binding="{Binding Заголовок}" Width="*"/>
                                <DataGridTextColumn Header="Текст" Binding="{Binding Текст_заметки}" Width="2*"/>
                                <DataGridTextColumn Header="Создана" Binding="{Binding Дата_создания, StringFormat='dd.MM.yyyy HH:mm'}" Width="140"/>
                                <DataGridTextColumn Header="Привязка" Binding="{Binding ПривязкаОтображение}" Width="*"/>
                                <DataGridTemplateColumn Header="Действия" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="ToggleNotePin_Click"
                                                    Tag="{Binding ID_заметки}"
                                                    Margin="2"
                                                    Padding="6,2"
                                                    Foreground="Black">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="📌 Закрепить"/>
                                                        <Setter Property="ToolTip" Value="Закрепить заметку"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Закреплена}" Value="True">
                                                                <Setter Property="Content" Value="📌 Снять"/>
                                                                <Setter Property="ToolTip" Value="Открепить заметку"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== ЧАТ ==================== -->
            <StackPanel x:Name="ChatPanel" Visibility="Collapsed" Margin="20">

                <!-- Заголовок чата с индикатором подключения -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Заголовок -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <!-- Иконка чата (адаптивная под тему) -->
                        <Border Width="40" Height="40" 
                                CornerRadius="20"
                                Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                            <TextBlock Text="💬" 
                                       FontSize="24" 
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Общий чат" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock x:Name="ChatStatusText" 
                                       Text="Подключение..." 
                                       FontSize="12" 
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Opacity="0.6"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Индикатор подключения -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Center">
                        <TextBlock x:Name="OnlineUsersCount" 
                                   Text="Состояние подключения:  " 
                                   FontSize="12" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Opacity="0.7"
                                   VerticalAlignment="Center"/>
                        <Ellipse x:Name="ConnectionIndicator" 
                                 Width="12" 
                                 Height="12" 
                                 Fill="Orange" 
                                 Margin="0,0,8,0"/>
                    </StackPanel>
                </Grid>

                <!-- Основная область чата -->
                <Border Background="{DynamicResource BackgroundBrush}" 
                        CornerRadius="12" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1"
                        Padding="0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Область сообщений -->
                        <Border Grid.Row="0" 
                                Background="{DynamicResource ChatBackgroundBrush}"
                                CornerRadius="12,12,0,0"
                                Padding="15">
                            <ScrollViewer x:Name="ChatScrollViewer" 
                                          VerticalScrollBarVisibility="Auto"
                                          Height="450">
                                <ItemsControl x:Name="ChatMessagesControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Индикатор набора текста -->
                        <Border x:Name="TypingIndicator" 
                                Grid.Row="1"
                                Visibility="Collapsed"
                                Background="{DynamicResource BackgroundBrush}"
                                Padding="15,5">
                            <TextBlock x:Name="TypingIndicatorText" 
                                       Text="Пользователь печатает..." 
                                       FontSize="11" 
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Opacity="0.6"/>
                        </Border>

                        <!-- Панель ввода сообщения -->
                        <Border Grid.Row="2" 
                                Background="{DynamicResource BackgroundBrush}"
                                CornerRadius="0,0,12,12"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Поле ввода с улучшенной отзывчивостью -->
                                <Border x:Name="MessageInputBorder"
                                        Grid.Column="0" 
                                        Background="{DynamicResource InputBackgroundBrush}"
                                        CornerRadius="20"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="2"
                                        Padding="15,10">

                                    <!-- Триггеры для визуальной обратной связи -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                            <Style.Triggers>
                                                <!-- При наведении - лёгкая подсветка -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBox x:Name="MessageTextBox" 
                                             Background="Transparent"
                                             BorderThickness="0"
                                             VerticalAlignment="Center"
                                             FontSize="14"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="False"
                                             MaxHeight="100"
                                             Foreground="{DynamicResource ForegroundBrush}"
                                             CaretBrush="{DynamicResource AccentBrush}"
                                             KeyDown="MessageTextBox_KeyDown"
                                             TextChanged="MessageTextBox_TextChanged"
                                             GotFocus="MessageTextBox_GotFocus"
                                             LostFocus="MessageTextBox_LostFocus">
                                        <TextBox.Resources>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <Grid>
                                                                <ScrollViewer x:Name="PART_ContentHost" 
                                                                              VerticalScrollBarVisibility="Auto"/>
                                                                <!-- Placeholder с анимацией -->
                                                                <TextBlock x:Name="PlaceholderText"
                                                                           Text="Введите сообщение..." 
                                                                           FontSize="14"
                                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                                           Opacity="0.5"
                                                                           IsHitTestVisible="False"
                                                                           VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </Border>

                                <!-- Кнопка эмодзи -->
                                <Button x:Name="EmojiButton" 
                                        Grid.Column="1"
                                        Width="45" 
                                        Height="45"
                                        Margin="10,0,0,0"
                                        Background="{DynamicResource InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Click="EmojiButton_Click"
                                        ToolTip="Добавить эмодзи">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="22.5"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                            <ContentPresenter HorizontalAlignment="Center" 
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                                                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="😊" FontSize="20"/>
                                </Button>

                                <!-- Кнопка отправки -->
                                <Button x:Name="SendButton" 
                                        Grid.Column="2"
                                        Width="45" 
                                        Height="45"
                                        Margin="10,0,0,0"
                                        Background="{DynamicResource AccentBrush}"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="SendButton_Click"
                                        ToolTip="Отправить сообщение (Enter)">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="22.5">
                                                            <ContentPresenter HorizontalAlignment="Center" 
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <!-- Иконка отправки -->
                                    <Path Fill="White" 
                                          Width="20" 
                                          Height="20"
                                          Stretch="Uniform"
                                          Data="M2,21L23,12L2,3V10L17,12L2,14V21Z"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Информационная панель внизу -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            Margin="0,10,0,0">
                    <Path Fill="{DynamicResource ForegroundBrush}" 
                          Opacity="0.5"
                          Width="14" 
                          Height="14"
                          Margin="0,0,5,0"
                          VerticalAlignment="Center"
                          Stretch="Uniform"
                          Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"/>
                    <TextBlock Text="Нажмите Enter для отправки • ПКМ на своём сообщении для удаления" 
                               FontSize="11" 
                               Foreground="{DynamicResource ForegroundBrush}"
                               Opacity="0.5"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- ==================== ПАНЕЛЬ ОТЧЁТОВ ==================== -->
            <ScrollViewer x:Name="ReportPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Отчёты и аналитика" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,20"/>

                    <!-- Панель управления экспортом -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="15" 
                            Margin="0,0,0,20" 
                            Background="{DynamicResource SecondaryBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="Экспорт отчётов" 
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="ExportTypeComboBox" 
                                         Width="200" 
                                         Margin="0,0,10,0">
                                    <ComboBoxItem Content="Проекты" IsSelected="True"/>
                                    <ComboBoxItem Content="Задачи"/>
                                </ComboBox>

                                <Button Content="📄 Экспорт в PDF" 
                                       Click="ExportToPDF_Click"
                                       Margin="0,0,10,0"
                                       Style="{StaticResource ExportPDFButtonStyle}"/>

                                <Button Content="📊 Экспорт в Excel" 
                                       Click="ExportToExcelNew_Click"
                                       Style="{StaticResource ExportExcelButtonStyle}"/>

                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Общая статистика -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="20" 
                            Margin="0,0,0,20" 
                            Background="{DynamicResource BackgroundBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Карточка 1: Всего проектов -->
                            <Border Grid.Column="0" 
                                   Background="#3498DB" 
                                   CornerRadius="8" 
                                   Padding="20" 
                                   Margin="5">
                                <StackPanel>
                                    <TextBlock Text="📁" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TotalProjectsCard" 
                                              Text="0" 
                                              FontSize="36" 
                                              FontWeight="Bold" 
                                              Foreground="White"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Всего проектов" 
                                              FontSize="14" 
                                              Foreground="White"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Карточка 2: Всего задач -->
                            <Border Grid.Column="1" 
                                   Background="#9B59B6" 
                                   CornerRadius="8" 
                                   Padding="20" 
                                   Margin="5">
                                <StackPanel>
                                    <TextBlock Text="📋" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TotalTasksCard" 
                                              Text="0" 
                                              FontSize="36" 
                                              FontWeight="Bold" 
                                              Foreground="White"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Всего задач" 
                                              FontSize="14" 
                                              Foreground="White"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Карточка 3: Завершённых задач -->
                            <Border Grid.Column="2" 
                                   Background="#27AE60" 
                                   CornerRadius="8" 
                                   Padding="20" 
                                   Margin="5">
                                <StackPanel>
                                    <TextBlock Text="✓" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="CompletedTasksCard" 
                                              Text="0" 
                                              FontSize="36" 
                                              FontWeight="Bold" 
                                              Foreground="White"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Завершено задач" 
                                              FontSize="14" 
                                              Foreground="White"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Карточка 4: Общий бюджет -->
                            <Border Grid.Column="3" 
                                   Background="#E67E22" 
                                   CornerRadius="8" 
                                   Padding="20" 
                                   Margin="5">
                                <StackPanel>
                                    <TextBlock Text="💰" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TotalBudgetCard" 
                                              Text="0 ₽" 
                                              FontSize="28" 
                                              FontWeight="Bold" 
                                              Foreground="White"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Общий бюджет" 
                                              FontSize="14" 
                                              Foreground="White"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Диаграммы в две колонки -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <!-- Диаграмма: Проекты по статусам -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" 
                                   BorderThickness="1" 
                                   CornerRadius="8" 
                                   Padding="15" 
                                   Margin="0,0,0,20" 
                                   Background="{DynamicResource BackgroundBrush}">
                                <StackPanel>
                                    <TextBlock Text="Проекты по статусам" 
                                              Foreground="{DynamicResource ForegroundBrush}"
                                              FontSize="16" 
                                              FontWeight="Bold" 
                                              Margin="0,0,0,15"/>
                                    <lvc:PieChart x:Name="ProjectsStatusPieChart" 
                                                 Height="300" 
                                                 LegendLocation="Bottom"/>
                                </StackPanel>
                            </Border>

                            <!-- Диаграмма: Задачи по приоритетам -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" 
                                   BorderThickness="1" 
                                   CornerRadius="8" 
                                   Padding="15" 
                                   Margin="0,0,0,20" 
                                   Background="{DynamicResource BackgroundBrush}">
                                <StackPanel>
                                    <TextBlock Text="Задачи по приоритетам" 
                                              Foreground="{DynamicResource ForegroundBrush}"
                                              FontSize="16" 
                                              FontWeight="Bold" 
                                              Margin="0,0,0,15"/>
                                    <lvc:PieChart x:Name="TasksPriorityPieChart" 
                                                 Height="300" 
                                                 LegendLocation="Bottom"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Правая колонка -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <!-- Диаграмма: Задачи по статусам -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" 
                                   BorderThickness="1" 
                                   CornerRadius="8" 
                                   Padding="15" 
                                   Margin="0,0,0,20" 
                                   Background="{DynamicResource BackgroundBrush}">
                                <StackPanel>
                                    <TextBlock Text="Задачи по статусам" 
                                              Foreground="{DynamicResource ForegroundBrush}"
                                              FontSize="16" 
                                              FontWeight="Bold" 
                                              Margin="0,0,0,15"/>
                                    <lvc:CartesianChart x:Name="TasksStatusBarChart" 
                                                       Height="300">
                                        <lvc:CartesianChart.AxisX>
                                            <lvc:Axis Labels="{Binding}" FontSize="12"/>
                                        </lvc:CartesianChart.AxisX>
                                        <lvc:CartesianChart.AxisY>
                                            <lvc:Axis Title="Количество" FontSize="12"/>
                                        </lvc:CartesianChart.AxisY>
                                    </lvc:CartesianChart>
                                </StackPanel>
                            </Border>

                            <!-- Диаграмма: Бюджеты проектов -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" 
                                   BorderThickness="1" 
                                   CornerRadius="8" 
                                   Padding="15" 
                                   Margin="0,0,0,20" 
                                   Background="{DynamicResource BackgroundBrush}">
                                <StackPanel>
                                    <TextBlock Text="ТОП-5 проектов по бюджету" 
                                              Foreground="{DynamicResource ForegroundBrush}"
                                              FontSize="16" 
                                              FontWeight="Bold" 
                                              Margin="0,0,0,15"/>
                                    <lvc:CartesianChart x:Name="ProjectsBudgetBarChart" 
                                                       Height="300">
                                        <lvc:CartesianChart.AxisX>
                                            <lvc:Axis Labels="{Binding}" FontSize="10"/>
                                        </lvc:CartesianChart.AxisX>
                                        <lvc:CartesianChart.AxisY>
                                            <lvc:Axis Title="Бюджет (₽)" FontSize="12" LabelFormatter="{Binding}"/>
                                        </lvc:CartesianChart.AxisY>
                                    </lvc:CartesianChart>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Анализ использования ресурсов -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" 
                           BorderThickness="1" 
                           CornerRadius="8" 
                           Padding="15" 
                           Margin="0,0,0,20" 
                           Background="{DynamicResource BackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="📦 Использование ресурсов" 
                                      Foreground="{DynamicResource ForegroundBrush}"
                                      FontSize="16" 
                                      FontWeight="Bold" 
                                      Margin="0,0,0,15"/>
                            <DataGrid x:Name="ResourcesUsageGrid" 
                                     AutoGenerateColumns="False" 
                                     IsReadOnly="True"
                                     Height="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ресурс" Binding="{Binding Название}" Width="*"/>
                                    <DataGridTextColumn Header="Тип" Binding="{Binding Тип}" Width="*"/>
                                    <DataGridTextColumn Header="Количество" Binding="{Binding Количество}" Width="100"/>
                                    <DataGridTextColumn Header="Используется в проектах" Binding="{Binding ПроектовИспользуется}" Width="180"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ==================== ПАНЕЛЬ ПОЛЬЗОВАТЕЛЕЙ ==================== -->
            <StackPanel x:Name="UsersPanel" Visibility="Collapsed" Margin="10">
                <TextBlock Text="Пользователи" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,10" 
                           HorizontalAlignment="Center"/>

                <Border Background="{DynamicResource BackgroundBrush}" 
                        CornerRadius="8" 
                        Padding="15" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="AddUserBtn" 
                                   Content="Добавить пользователя" 
                                   Width="200"
                                   Click="AddUserBtn_Click"
                                   Margin="0,0,10,0"
                                   Style="{StaticResource AddButtonStyle}"/>
                            <Button x:Name="EditUserBtn" 
                                   Content="Редактировать" 
                                   Click="EditUserBtn_Click" 
                                   Width="150"
                                   Margin="0,0,10,0"
                                   Style="{StaticResource EditButtonStyle}"/>
                            <Button x:Name="DeleteUserBtn" 
                                   Content="Удалить" 
                                   Width="150"
                                   Click="DeleteUserBtn_Click"
                                   Style="{StaticResource DeleteButtonStyle}"/>
                        </StackPanel>

                        <DataGrid x:Name="UsersGrid" 
                                 AutoGenerateColumns="False" 
                                 IsReadOnly="True" 
                                 Height="600">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                                <DataGridTextColumn Header="Имя" Binding="{Binding Имя}" Width="*"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                                <DataGridTextColumn Header="Роль" Binding="{Binding Роль}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== ПАНЕЛЬ УВЕДОМЛЕНИЙ ==================== -->
            <StackPanel x:Name="NotificationsPanel" Visibility="Collapsed" Margin="10">
                <TextBlock Text="Уведомления" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,20"/>

                <!-- Панель управления -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Отметить все как прочитанные" 
                           Click="MarkAllAsRead_Click"
                           Margin="0,0,10,0"
                           Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="Очистить прочитанные" 
                           Click="ClearReadNotifications_Click"
                           Margin="0,0,10,0"
                           Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="Обновить" 
                           Click="RefreshNotifications_Click"
                           Style="{StaticResource ActionButtonStyle}"/>
                </StackPanel>

                <!-- Фильтры -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Фильтр:" 
                              Foreground="{DynamicResource ForegroundBrush}"
                              VerticalAlignment="Center" 
                              Margin="0,0,10,0"/>
                    <RadioButton x:Name="AllNotificationsRadio" 
                                Content="Все" 
                                IsChecked="True"
                                GroupName="NotificationFilter"
                                Checked="NotificationFilter_Changed"
                                Margin="0,20,15,0"/>
                    <RadioButton x:Name="UnreadNotificationsRadio" 
                                Content="Непрочитанные" 
                                GroupName="NotificationFilter"
                                Checked="NotificationFilter_Changed"
                                Margin="0,20,15,0"/>

                    <TextBlock Text="Тип:" 
                              Foreground="{DynamicResource ForegroundBrush}"
                              VerticalAlignment="Center" 
                              Margin="20,0,10,0"/>
                    <ComboBox x:Name="NotificationTypeFilter" 
                             Width="150"
                             SelectionChanged="NotificationFilter_Changed">
                        <ComboBoxItem Content="Все типы" IsSelected="True"/>
                        <ComboBoxItem Content="Задача"/>
                        <ComboBoxItem Content="Проект"/>
                        <ComboBoxItem Content="Напоминание"/>
                        <ComboBoxItem Content="Событие"/>
                        <ComboBoxItem Content="Система"/>
                    </ComboBox>
                </StackPanel>

                <!-- Список уведомлений -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="500">
                    <ItemsControl x:Name="NotificationsListBox">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" 
                                       BorderThickness="1" 
                                       CornerRadius="5" 
                                       Padding="10" 
                                       Margin="0,0,0,5"
                                       Background="{Binding BackgroundColor}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                  Text="{Binding ТипИконка}" 
                                                  FontSize="24"
                                                  VerticalAlignment="Top"
                                                  Margin="0,0,10,0"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Заголовок}" 
                                                      FontWeight="Bold" 
                                                      FontSize="15"
                                                      Foreground="White"
                                                      TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Текст}" 
                                                      FontSize="13"
                                                      Foreground="#DDDDDD"
                                                      TextWrapping="Wrap"
                                                      Margin="0,5,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding ВремяС_момента_создания}" 
                                                          FontSize="11"
                                                          Foreground="#AAAAAA"/>
                                                <TextBlock Text=" • " 
                                                          FontSize="11"
                                                          Foreground="#AAAAAA"
                                                          Margin="5,0"/>
                                                <TextBlock Text="{Binding Приоритет}" 
                                                          FontSize="11"
                                                          Foreground="{Binding ПриоритетЦвет}"
                                                          FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" 
                                                   Orientation="Horizontal"
                                                   VerticalAlignment="Center">
                                            <Button Content="✓" 
                                                   ToolTip="Отметить как прочитанное"
                                                   Width="30" 
                                                   Height="30"
                                                   Margin="5,0"
                                                   Click="MarkAsRead_Click"
                                                   Tag="{Binding ID}"
                                                   Visibility="{Binding ReadButtonVisibility}"/>
                                            <Button Content="🗑" 
                                                   ToolTip="Удалить"
                                                   Width="30" 
                                                   Height="30"
                                                   Click="DeleteNotification_Click"
                                                   Tag="{Binding ID}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="NoNotificationsText"
                          Text="У вас пока нет уведомлений"
                          FontSize="16"
                          Foreground="{DynamicResource DisabledForegroundBrush}"
                          HorizontalAlignment="Center"
                          Margin="0,50,0,0"
                          Visibility="Collapsed"/>
            </StackPanel>

            <!-- ==================== ПАНЕЛЬ ИСТОРИИ ИЗМЕНЕНИЙ ==================== -->
            <StackPanel x:Name="HistoryPanel" Visibility="Collapsed" Margin="10">
                <TextBlock Text="История изменений" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,20" 
                           HorizontalAlignment="Center"/>

                <Border Background="{DynamicResource BackgroundBrush}" 
                        CornerRadius="8" 
                        Padding="15" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1">
                    <StackPanel>
                        <!-- Фильтры истории -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Тип:" 
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="14" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1"
                                      x:Name="HistoryTypeFilter" 
                                      Height="32"
                                      SelectionChanged="HistoryFilters_Changed"
                                      Margin="0,0,20,0">
                                <ComboBoxItem Content="Все" IsSelected="True"/>
                                <ComboBoxItem Content="Проект"/>
                                <ComboBoxItem Content="Задача"/>
                            </ComboBox>

                            <TextBlock Grid.Column="2"
                                       Text="Сотрудник:" 
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="14" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0"/>
                            <TextBox Grid.Column="3"
                                     x:Name="HistoryEmployeeSearchBox" 
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     TextChanged="HistoryFilters_Changed" 
                                     Margin="0,0,20,0"/>

                            <TextBlock Grid.Column="4"
                                       Text="Период:" 
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="14" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="5" 
                                        Orientation="Horizontal"
                                        Width="350" 
                                        Margin="0,0,20,0">
                                <DatePicker x:Name="HistoryStartDatePicker" 
                                           SelectedDateChanged="HistoryFilters_Changed" 
                                           Width="120" 
                                           Height="32"
                                           Margin="0,0,5,0"/>
                                <TextBlock Text="до" 
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           VerticalAlignment="Center" 
                                           Margin="5,0"/>
                                <DatePicker x:Name="HistoryEndDatePicker" 
                                           SelectedDateChanged="HistoryFilters_Changed" 
                                           Width="120" 
                                           Height="32"
                                           Margin="5,0,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="6"
                                    Content="Сброс фильтров" 
                                    Click="ResetHistoryFiltersBtn_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                        </Grid>

                        <!-- Информационная панель -->
                        <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊 Всего записей: " 
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="TotalHistoryCountText" 
                                           Text="0" 
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="5,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Таблица истории -->
                        <DataGrid x:Name="HistoryGrid" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  Height="500"
                                  SelectionMode="Single">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" 
                                                    Binding="{Binding Дата_изменения, StringFormat='dd.MM.yyyy HH:mm'}" 
                                                    Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Тип объекта" 
                                                    Binding="{Binding Сущность}" 
                                                    Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="ID объекта" 
                                                    Binding="{Binding ID_объекта}" 
                                                    Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Изменение" 
                                                    Binding="{Binding Действие}" 
                                                    Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Сотрудник" 
                                                    Binding="{Binding ФИО_сотрудника}" 
                                                    Width="1.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
            
        </Grid>
    </DockPanel>
</Window>