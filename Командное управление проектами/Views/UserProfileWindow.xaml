<Window x:Class="Командное_управление_проектами.Views.UserProfileWindow"
        Icon="pack://application:,,,/Resources/checklist.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профиль пользователя"
        Height="750" Width="900" 
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <!-- Стиль для кнопок меню -->
        <Style x:Key="ProfileMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                Margin="5,3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для активной кнопки меню -->
        <Style x:Key="ActiveProfileMenuButton" TargetType="Button" BasedOn="{StaticResource ProfileMenuButton}">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Стиль для заголовков полей -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Стиль для текстовых полей -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для кнопки сохранения -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#229954"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E8449"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для карточек статистики -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левое меню -->
        <Border Grid.Column="0" 
                Background="{DynamicResource SecondaryBackgroundBrush}" 
                Padding="0">
            <StackPanel>
                <!-- Шапка профиля с аватаром -->
                <Border Background="{DynamicResource HoverBrush}" 
                        Padding="20" 
                        Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Круглый аватар -->
                        <Ellipse Width="100" 
                                 Height="100" 
                                 Fill="{DynamicResource AccentBrush}" 
                                 Margin="0,0,0,15">
                            <Ellipse.Effect>
                                <DropShadowEffect ShadowDepth="2" 
                                                  BlurRadius="10" 
                                                  Opacity="0.3"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <!-- Инициалы поверх аватара -->
                        <TextBlock x:Name="UserInitials" 
                                   Text="ИП" 
                                   FontSize="36" 
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,-85,0,60"/>

                        <!-- Имя пользователя -->
                        <TextBlock x:Name="UserFullName" 
                                   Text="Иванов Иван Петрович" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <!-- Роль пользователя -->
                        <TextBlock x:Name="UserRole" 
                                   Text="Администратор" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Opacity="0.7"
                                   TextAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Кнопки навигации по вкладкам -->
                <Button x:Name="ProfileTab" 
                        Content="👤 Основная информация" 
                        Click="ShowProfileTab"
                        Style="{StaticResource ActiveProfileMenuButton}"/>

                <Button x:Name="SettingsTab" 
                        Content="⚙️ Настройки" 
                        Click="ShowSettingsTab"
                        Style="{StaticResource ProfileMenuButton}"/>

                <Button x:Name="StatsTab" 
                        Content="📊 Моя статистика" 
                        Click="ShowStatsTab"
                        Style="{StaticResource ProfileMenuButton}"/>
            </StackPanel>
        </Border>

        <!-- Правая панель с контентом -->
        <Grid Grid.Column="1">
            <Border Background="{DynamicResource BackgroundBrush}" 
                    Padding="30">
                <Grid>
                    <!-- ============ ВКЛАДКА: ОСНОВНАЯ ИНФОРМАЦИЯ ============ -->
                    <StackPanel x:Name="ProfileTabContent" 
                                Visibility="Visible">
                        <TextBlock Text="Основная информация" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,0,0,20"/>

                        <!-- Фамилия -->
                        <TextBlock Text="Фамилия:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="LastNameBox" 
                                 Style="{StaticResource InputTextBoxStyle}"
                                 ToolTip="Введите фамилию"/>

                        <!-- Имя -->
                        <TextBlock Text="Имя:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="FirstNameBox" 
                                 Style="{StaticResource InputTextBoxStyle}"
                                 ToolTip="Введите имя"/>

                        <!-- Отчество -->
                        <TextBlock Text="Отчество:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="MiddleNameBox" 
                                 Style="{StaticResource InputTextBoxStyle}"
                                 ToolTip="Введите отчество"/>

                        <!-- Email (только чтение) -->
                        <TextBlock Text="Email:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="EmailBox" 
                                 Style="{StaticResource InputTextBoxStyle}"
                                 IsReadOnly="True" 
                                 Background="{DynamicResource DisabledBackgroundBrush}"
                                 ToolTip="Email изменить нельзя"/>

                        <!-- Роль (только чтение) -->
                        <TextBlock Text="Роль:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="RoleBox" 
                                 Style="{StaticResource InputTextBoxStyle}"
                                 IsReadOnly="True" 
                                 Background="{DynamicResource DisabledBackgroundBrush}"
                                 ToolTip="Роль изменить нельзя"/>

                        <!-- Отдел -->
                        <TextBlock Text="Отдел:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="DepartmentComboBox" 
                                  Height="35"
                                  Margin="0,0,0,20"
                                  ToolTip="Выберите отдел">
                            <ComboBoxItem Content="IT"/>
                            <ComboBoxItem Content="Разработка"/>
                            <ComboBoxItem Content="Дизайн"/>
                            <ComboBoxItem Content="Тестирование"/>
                            <ComboBoxItem Content="Маркетинг"/>
                            <ComboBoxItem Content="Продажи"/>
                        </ComboBox>

                        <!-- Кнопка сохранения профиля -->
                        <Button Content="💾 Сохранить изменения" 
                                Click="SaveProfile_Click"
                                Style="{StaticResource SaveButtonStyle}"
                                Width="220"
                                HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- ============ ВКЛАДКА: НАСТРОЙКИ ============ -->
                    <StackPanel x:Name="SettingsTabContent" 
                                Visibility="Collapsed">
                        <TextBlock Text="Настройки приложения" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,0,0,20"/>

                        <!-- Тема оформления -->
                        <TextBlock Text="Тема оформления:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="ThemeComboBox" 
                                  Height="35"
                                  Margin="0,0,0,15"
                                  ToolTip="Выберите тему приложения">
                            <ComboBoxItem Content="Светлая"/>
                            <ComboBoxItem Content="Тёмная"/>
                        </ComboBox>

                        <!-- Уведомления -->
                        <CheckBox x:Name="NotificationsCheckBox" 
                                  Content="Включить уведомления" 
                                  IsChecked="True"
                                  FontSize="14"
                                  Margin="0,0,0,15"
                                  Checked="NotificationsCheckBox_Changed"
                                  Unchecked="NotificationsCheckBox_Changed"
                                  ToolTip="Включить/выключить уведомления о задачах"/>

                        <!-- Звуковые уведомления -->
                        <CheckBox x:Name="SoundCheckBox" 
                                  Content="Звуковые уведомления" 
                                  IsChecked="True"
                                  FontSize="14"
                                  Margin="0,0,0,15"
                                  ToolTip="Включить звуковые сигналы при уведомлениях"/>

                        <!-- Частота проверки дедлайнов -->
                        <TextBlock Text="Частота проверки дедлайнов (минуты):" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CheckFrequencyComboBox" 
                                  Height="35"
                                  Margin="0,0,0,15"
                                  ToolTip="Как часто проверять дедлайны">
                            <ComboBoxItem Content="15"/>
                            <ComboBoxItem Content="30" IsSelected="True"/>
                            <ComboBoxItem Content="60"/>
                            <ComboBoxItem Content="120"/>
                        </ComboBox>

                        <!-- Показывать завершённые задачи -->
                        <CheckBox x:Name="ShowCompletedCheckBox" 
                                  Content="Показывать завершённые задачи" 
                                  IsChecked="True"
                                  FontSize="14"
                                  Margin="0,0,0,20"
                                  ToolTip="Отображать завершённые задачи в списке"/>

                        <!-- Кнопка сохранения настроек -->
                        <Button Content="💾 Сохранить настройки" 
                                Click="SaveSettings_Click"
                                Style="{StaticResource SaveButtonStyle}"
                                Width="220"
                                HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- ============ ВКЛАДКА: СТАТИСТИКА ============ -->
                    <StackPanel x:Name="StatsTabContent" 
                                Visibility="Collapsed">
                        <TextBlock Text="Моя статистика" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,0,0,20"/>

                        <!-- Карточки статистики: первая строка -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Карточка: Мои проекты -->
                            <Border Grid.Column="0" 
                                    Background="#3498DB" 
                                    Style="{StaticResource StatCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="📁" 
                                               FontSize="32" 
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="MyProjectsCount" 
                                               Text="0" 
                                               FontSize="36" 
                                               FontWeight="Bold" 
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Мои проекты" 
                                               FontSize="14" 
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Карточка: Мои задачи -->
                            <Border Grid.Column="2" 
                                    Background="#9B59B6" 
                                    Style="{StaticResource StatCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="📋" 
                                               FontSize="32" 
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="MyTasksCount" 
                                               Text="0" 
                                               FontSize="36" 
                                               FontWeight="Bold" 
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Мои задачи" 
                                               FontSize="14" 
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Карточки статистики: вторая строка -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Карточка: Завершённые задачи -->
                            <Border Grid.Column="0" 
                                    Background="#27AE60" 
                                    Style="{StaticResource StatCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="✓" 
                                               FontSize="32" 
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="MyCompletedTasksCount" 
                                               Text="0" 
                                               FontSize="36" 
                                               FontWeight="Bold" 
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Завершено задач" 
                                               FontSize="14" 
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Карточка: Просроченные -->
                            <Border Grid.Column="2" 
                                    Background="#E74C3C" 
                                    Style="{StaticResource StatCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="⚠️" 
                                               FontSize="32" 
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="MyOverdueTasksCount" 
                                               Text="0" 
                                               FontSize="36" 
                                               FontWeight="Bold" 
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Просрочено" 
                                               FontSize="14" 
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Последняя активность -->
                        <TextBlock Text="Последняя активность" 
                                   FontWeight="Bold" 
                                   FontSize="16" 
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,20,0,10"/>
                        <DataGrid x:Name="RecentActivityGrid" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True"
                                  Height="205">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" 
                                                    Binding="{Binding Дата}" 
                                                    Width="120"/>
                                <DataGridTextColumn Header="Действие" 
                                                    Binding="{Binding Действие}" 
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
