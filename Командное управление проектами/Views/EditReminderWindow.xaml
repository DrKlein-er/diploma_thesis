<Window x:Class="Командное_управление_проектами.Views.EditReminderWindow"
        Icon="pack://application:,,,/Resources/checklist.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Командное_управление_проектами.Views"
        mc:Ignorable="d"
        Title="Редактировать напоминание" Height="530" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Border Background="{DynamicResource BackgroundBrush}" 
            CornerRadius="10" 
            Padding="35" 
            Margin="20"
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1">
        <StackPanel>
            <!-- Заголовок окна -->
            <TextBlock Text="Редактировать напоминание" 
                       FontSize="26" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource ForegroundBrush}"
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,25"/>

            <!-- Поле "Текст напоминания" -->
            <TextBlock Text="Текст напоминания:" 
                       Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="TextBoxReminder" 
                     Style="{StaticResource MultilineTextBoxStyle}"
                     ToolTip="Введите текст напоминания"
                     MaxLength="500"/>

            <!-- Поле "Дата напоминания" -->
            <TextBlock Text="Дата напоминания:" 
                       Style="{StaticResource FieldLabelStyle}"/>
            <DatePicker x:Name="ReminderDatePicker"
                        Height="35"
                        Margin="0,0,0,15"
                        ToolTip="Выберите дату напоминания"/>

            <!-- Поле "Связанная задача" -->
            <TextBlock Text="Связанная задача:" 
                       Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="TaskComboBox" 
                      Height="35"
                      Margin="0,0,0,20"
                      SelectedValuePath="ID_задачи"
                      ToolTip="Выберите задачу, к которой относится напоминание">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Название_задачи}" 
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Кнопка сохранения -->
            <Button Content="Сохранить изменения" 
                    Click="Save_Click" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="220"
                    Height="42"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,0"/>
        </StackPanel>
    </Border>
</Window>