<Window x:Class="Командное_управление_проектами.Views.EditProjectWindow"
        Icon="pack://application:,,,/Resources/checklist.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Командное_управление_проектами.Views"
        mc:Ignorable="d"
        Title="Редактировать проект" Height="830" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Border Background="{DynamicResource BackgroundBrush}" 
            CornerRadius="10" 
            Padding="35" 
            Margin="20"
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок окна -->
            <TextBlock Grid.Row="0"
                       Text="Редактировать проект" 
                       FontSize="26" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource ForegroundBrush}"
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,25"/>

            <!-- TabControl -->
            <TabControl Grid.Row="1">
                <!-- Вкладка: Основная информация -->
                <TabItem Header="Основная информация">
                    <StackPanel Margin="20">
                        <!-- Поле "Название" -->
                        <TextBlock Text="Название проекта:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TitleBox" 
                                 Style="{StaticResource InputTextBoxStyle}"
                                 ToolTip="Введите название проекта"
                                 MaxLength="100"/>

                        <!-- Поле "Описание" -->
                        <TextBlock Text="Описание:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="DescBox" 
                                 Style="{StaticResource MultilineTextBoxStyle}"
                                 ToolTip="Введите описание проекта"
                                 MaxLength="500"/>

                        <!-- Поле "Дата начала" -->
                        <TextBlock Text="Дата начала:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker x:Name="StartDate" 
                                    Height="35"
                                    Margin="0,0,0,15"
                                    ToolTip="Выберите дату начала проекта"/>

                        <!-- Поле "Дата завершения" -->
                        <TextBlock Text="Дата завершения:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker x:Name="EndDate" 
                                    Height="35"
                                    Margin="0,0,0,15"
                                    ToolTip="Выберите дату завершения проекта"/>

                        <!-- Поле "Статус" -->
                        <TextBlock Text="Статус:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="StatusBox" 
                                  Height="35"
                                  Margin="0,0,0,15"
                                  ToolTip="Выберите статус проекта">
                            <ComboBoxItem Content="В процессе"/>
                            <ComboBoxItem Content="Завершен"/>
                            <ComboBoxItem Content="Отложен"/>
                        </ComboBox>

                        <!-- Поле "Ответственный" -->
                        <TextBlock Text="Ответственный:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="EmployeeComboBox" 
                                  Height="35"
                                  Margin="0,0,0,15"
                                  SelectedValuePath="ID_сотрудника"
                                  ToolTip="Выберите ответственного сотрудника">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Имя_сотрудника}" 
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Кнопка сохранения -->
                        <Button x:Name="SaveProjectBtn"
                                Content="Сохранить изменения" 
                                Click="Save_Click" 
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="220"
                                Height="42"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0"/>
                    </StackPanel>
                </TabItem>

                <!-- Вкладка: Бюджет -->
                <TabItem x:Name="BudgetTab" Header="Бюджет">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- DataGrid для бюджета -->
                        <DataGrid x:Name="BudgetGrid" 
                                  Grid.Row="0"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True"
                                  Margin="0,0,0,15">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Назначение" Binding="{Binding Назначение}" Width="*"/>
                                <DataGridTextColumn Header="Сумма ₽" Binding="{Binding Сумма}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Кнопки управления бюджетом -->
                        <StackPanel Grid.Row="1" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Center">
                            <Button x:Name="AddBudgetButton" 
                                    Content="Добавить" 
                                    Click="AddBudget_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="220"
                                    Margin="5"/>
                            <Button x:Name="DeleteBudgetButton" 
                                    Content="Удалить" 
                                    Click="DeleteBudget_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="220"
                                    Margin="5"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Вкладка: Ресурсы -->
                <TabItem x:Name="ResourcesTab" Header="Ресурсы">
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок: Доступные ресурсы -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Доступные ресурсы" 
                                   Style="{StaticResource FieldLabelStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <!-- Список доступных ресурсов -->
                        <ListBox x:Name="AvailableResourcesList" 
                                 Grid.Row="1" Grid.Column="0"
                                 DisplayMemberPath="Название"
                                 Margin="0,0,5,0"
                                 Background="{DynamicResource TextBoxBackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>

                        <!-- Кнопки назначения/удаления ресурсов -->
                        <StackPanel Grid.Row="1" Grid.Column="1" 
                                    VerticalAlignment="Center"
                                    Margin="10,0">
                            <!-- Кнопка "Назначить ресурс" -->
                            <Button x:Name="AssignResourceButton" 
                                    Width="50"
                                    Height="40"
                                    Click="AssignResource_Click"
                                    Style="{StaticResource ArrowButtonStyle}"
                                    ToolTip="Назначить ресурс"
                                    Margin="0,5">
                                <Viewbox Width="14" Height="14">
                                    <Path Data="M 0,0 L 10,5 L 0,10 Z" 
                                          Fill="White"/>
                                </Viewbox>
                            </Button>

                            <!-- Кнопка "Удалить ресурс" -->
                            <Button x:Name="RemoveResourceButton" 
                                    Width="50"
                                    Height="40"
                                    Click="RemoveResource_Click"
                                    Style="{StaticResource ArrowButtonStyle}"
                                    ToolTip="Удалить ресурс"
                                    Margin="0,5">
                                <Viewbox Width="14" Height="14">
                                    <Path Data="M 10,0 L 0,5 L 10,10 Z" 
                                          Fill="White"/>
                                </Viewbox>
                            </Button>
                        </StackPanel>

                        <!-- Заголовок: Ресурсы проекта -->
                        <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="Ресурсы проекта" 
                               Style="{StaticResource FieldLabelStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                        <!-- Список назначенных ресурсов -->
                        <ListBox x:Name="AssignedResourcesList" 
                                 Grid.Row="1" Grid.Column="2"
                                 DisplayMemberPath="Название"
                                 Margin="5,0,0,0"
                                 Background="{DynamicResource TextBoxBackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                    </Grid>
                </TabItem>

                <!-- Вкладка: История -->
                <TabItem x:Name="HistoryTab" Header="История">
                    <DataGrid x:Name="HistoryGrid" 
                              Margin="20"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Дата_изменения, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding Имя_сотрудника}" Width="*"/>
                            <DataGridTextColumn Header="Изменение" Binding="{Binding Описание_изменения}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>