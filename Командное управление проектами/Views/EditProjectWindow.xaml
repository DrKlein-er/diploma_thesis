<Window x:Class="Командное_управление_проектами.Views.EditProjectWindow"
        Icon="pack://application:,,,/Resources/checklist.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Командное_управление_проектами.Views"
        mc:Ignorable="d"
        Title="Редактировать проект" Height="690" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <!-- Стиль для заголовков полей -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Стиль для текстовых полей -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для многострочного текста -->
        <Style x:Key="MultilineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="Height" Value="80"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!-- Стиль для кнопок -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            CornerRadius="6" 
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004578"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Локальный стиль для TabControl -->
        <Style x:Key="CustomTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Локальный стиль для TabItem -->
        <Style x:Key="CustomTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="6,6,0,0"
                            Padding="{TemplateBinding Padding}"
                            Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}" 
            CornerRadius="10" 
            Padding="20" 
            Margin="15"
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок окна -->
            <TextBlock Grid.Row="0"
                       Text="Редактировать проект" 
                       FontSize="26" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource ForegroundBrush}"
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

            <!-- TabControl -->
            <TabControl Grid.Row="1" Style="{StaticResource CustomTabControlStyle}">
                <!-- Вкладка: Основная информация -->
                <TabItem Header="Основная информация" Style="{StaticResource CustomTabItemStyle}">
                    <StackPanel Margin="15">
                        <!-- Поле "Название" -->
                        <TextBlock Text="Название проекта:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TitleBox" 
                                 Style="{StaticResource InputTextBoxStyle}"
                                 ToolTip="Введите название проекта"
                                 MaxLength="100"/>

                        <!-- Поле "Описание" -->
                        <TextBlock Text="Описание:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="DescBox" 
                                 Style="{StaticResource MultilineTextBoxStyle}"
                                 ToolTip="Введите описание проекта"
                                 MaxLength="500"/>

                        <!-- Поле "Дата начала" -->
                        <TextBlock Text="Дата начала:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker x:Name="StartDate" 
                                    Height="35"
                                    Margin="0,0,0,15"
                                    ToolTip="Выберите дату начала проекта"/>

                        <!-- Поле "Дата завершения" -->
                        <TextBlock Text="Дата завершения:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker x:Name="EndDate" 
                                    Height="35"
                                    Margin="0,0,0,15"
                                    ToolTip="Выберите дату завершения проекта"/>

                        <!-- Поле "Статус" -->
                        <TextBlock Text="Статус:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="StatusBox" 
                                  Height="35"
                                  Margin="0,0,0,15"
                                  ToolTip="Выберите статус проекта">
                            <ComboBoxItem Content="В процессе"/>
                            <ComboBoxItem Content="Завершен"/>
                            <ComboBoxItem Content="Отложен"/>
                        </ComboBox>

                        <!-- Поле "Ответственный" -->
                        <TextBlock Text="Ответственный:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="EmployeeComboBox" 
                                  Height="35"
                                  Margin="0,0,0,15"
                                  SelectedValuePath="ID_сотрудника"
                                  ToolTip="Выберите ответственного сотрудника">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Имя_сотрудника}" 
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </TabItem>

                <!-- Вкладка: Бюджет -->
                <TabItem x:Name="BudgetTab" Header="Бюджет" Style="{StaticResource CustomTabItemStyle}">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- DataGrid для бюджета -->
                        <DataGrid x:Name="BudgetGrid" 
                                  Grid.Row="0"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True"
                                  Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Назначение" Binding="{Binding Назначение}" Width="*"/>
                                <DataGridTextColumn Header="Сумма" Binding="{Binding Сумма}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Кнопки управления бюджетом -->
                        <StackPanel Grid.Row="1" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Right">
                            <Button x:Name="AddBudgetButton" 
                                    Content="Добавить" 
                                    Click="AddBudget_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button x:Name="DeleteBudgetButton" 
                                    Content="Удалить" 
                                    Click="DeleteBudget_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Вкладка: Ресурсы -->
                <TabItem x:Name="ResourcesTab" Header="Ресурсы" Style="{StaticResource CustomTabItemStyle}">
                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок: Доступные ресурсы -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Доступные ресурсы" 
                                   Style="{StaticResource FieldLabelStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <!-- Список доступных ресурсов -->
                        <ListBox x:Name="AvailableResourcesList" 
                                 Grid.Row="1" Grid.Column="0"
                                 DisplayMemberPath="Название"
                                 Margin="0,0,5,0"
                                 Background="{DynamicResource TextBoxBackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>

                        <!-- Кнопки назначения/удаления -->
                        <StackPanel Grid.Row="1" Grid.Column="1" 
                                    VerticalAlignment="Center"
                                    Margin="10,0">
                            <Button x:Name="AssignResourceButton" 
                                    Content="►" 
                                    Width="40"
                                    Height="35"
                                    Click="AssignResource_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="Назначить ресурс"/>
                            <Button x:Name="RemoveResourceButton" 
                                    Content="◄" 
                                    Width="40"
                                    Height="35"
                                    Click="RemoveResource_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="Удалить ресурс"/>
                        </StackPanel>

                        <!-- Заголовок: Ресурсы проекта -->
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="Ресурсы проекта" 
                                   Style="{StaticResource FieldLabelStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <!-- Список назначенных ресурсов -->
                        <ListBox x:Name="AssignedResourcesList" 
                                 Grid.Row="1" Grid.Column="2"
                                 DisplayMemberPath="Название"
                                 Margin="5,0,0,0"
                                 Background="{DynamicResource TextBoxBackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                    </Grid>
                </TabItem>

                <!-- Вкладка: История изменений -->
                <TabItem x:Name="HistoryTab" Header="История" Style="{StaticResource CustomTabItemStyle}">
                    <DataGrid x:Name="HistoryGrid" 
                              Margin="15"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Дата_изменения, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding Имя_сотрудника}" Width="150"/>
                            <DataGridTextColumn Header="Изменение" Binding="{Binding Описание_изменения}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <!-- Кнопка сохранения -->
            <Button Grid.Row="2"
                    Content="Сохранить изменения" 
                    Click="Save_Click" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="200"
                    Height="42"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0"/>
        </Grid>
    </Border>
</Window>
