<Window x:Class="Командное_управление_проектами.Views.AddSubtaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Icon="pack://application:,,,/Resources/checklist.ico"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Командное_управление_проектами.Views"
        mc:Ignorable="d"
        Title="Добавить подзадачу" Height="660" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <!-- Стиль для заголовков полей -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Стиль для текстовых полей -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для многострочного текста -->
        <Style x:Key="MultilineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="Height" Value="80"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!-- Стиль для кнопки -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="25,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004578"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}" 
            CornerRadius="10" 
            Padding="35" 
            Margin="20"
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1">
        <StackPanel>
            <!-- Заголовок окна -->
            <TextBlock Text="Добавить подзадачу" 
                       FontSize="26" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundBrush}" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,25"/>

            <!-- Поле "Название" -->
            <TextBlock Text="Название:" 
                       Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="TitleTextBox" 
                     Style="{StaticResource InputTextBoxStyle}"
                     ToolTip="Введите название подзадачи"
                     MaxLength="200"/>

            <!-- Поле "Описание" -->
            <TextBlock Text="Описание:" 
                       Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="DescTextBox" 
                     Style="{StaticResource MultilineTextBoxStyle}"
                     ToolTip="Введите описание подзадачи (необязательно)"
                     MaxLength="1000"/>

            <!-- Поле "Статус" -->
            <TextBlock Text="Статус:" 
                       Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="StatusComboBox" 
                      Height="35"
                      Margin="0,0,0,15"
                      ToolTip="Выберите статус подзадачи">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBoxItem Content="Открыта" IsSelected="True"/>
                <ComboBoxItem Content="В процессе"/>
                <ComboBoxItem Content="Завершена"/>
            </ComboBox>

            <!-- Поле "Дата начала" -->
            <TextBlock Text="Дата начала:" 
                       Style="{StaticResource FieldLabelStyle}"/>
            <DatePicker x:Name="StartDatePicker" 
                        Margin="0,0,0,15"
                        ToolTip="Выберите дату начала подзадачи (необязательно)"/>

            <!-- Поле "Дата завершения" -->
            <TextBlock Text="Дата завершения:" 
                       Style="{StaticResource FieldLabelStyle}"/>
            <DatePicker x:Name="EndDatePicker" 
                        Margin="0,0,0,15"
                        ToolTip="Выберите дату завершения подзадачи (необязательно)"/>

            <!-- Кнопка добавления -->
            <Button Content="Добавить подзадачу" 
                    Click="Add_Click" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="220"
                    Height="42"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,0"/>
        </StackPanel>
    </Border>
</Window>