<Window x:Class="Командное_управление_проектами.Views.EditEventWindow"
        Icon="pack://application:,,,/Resources/checklist.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Командное_управление_проектами.Views"
        mc:Ignorable="d"
        Title="Редактировать событие" Height="880" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MultilineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="Height" Value="80"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="25,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004578"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}" 
            CornerRadius="10" 
            Padding="35" 
            Margin="20"
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Редактировать событие" 
                           FontSize="26" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,25"/>

                <TextBlock Text="Название события:" 
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="TitleBox" 
                         Style="{StaticResource InputTextBoxStyle}"
                         MaxLength="100"/>

                <TextBlock Text="Тип события:" 
                           Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="TypeComboBox"
                          Height="35"
                          Margin="0,0,0,15">
                    <ComboBoxItem Content="Встреча"/>
                    <ComboBoxItem Content="Дедлайн"/>
                    <ComboBoxItem Content="Презентация"/>
                    <ComboBoxItem Content="Личное"/>
                    <ComboBoxItem Content="Другое"/>
                </ComboBox>

                <TextBlock Text="Описание:" 
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="DescBox" 
                         Style="{StaticResource MultilineTextBoxStyle}"
                         MaxLength="500"/>

                <TextBlock Text="Дата начала:" 
                           Style="{StaticResource FieldLabelStyle}"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Name="StartDatePicker" Grid.Column="0"/>
                    <TextBox x:Name="StartTimeBox" Grid.Column="2"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0"
                             MaxLength="5"/>
                </Grid>

                <TextBlock Text="Дата окончания (необязательно):" 
                           Style="{StaticResource FieldLabelStyle}"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Name="EndDatePicker" Grid.Column="0"/>
                    <TextBox x:Name="EndTimeBox" Grid.Column="2"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0"
                             MaxLength="5"/>
                </Grid>

                <TextBlock Text="Место проведения:" 
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="PlaceBox" 
                         Style="{StaticResource InputTextBoxStyle}"
                         MaxLength="200"/>

                <TextBlock Text="Связанный проект:" 
                           Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="ProjectComboBox" 
                          Height="35"
                          Margin="0,0,0,15" 
                          SelectedValuePath="ID_проекта"
                          SelectionChanged="ProjectComboBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Название_проекта}" 
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Связанная задача:" 
                           Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="TaskComboBox" 
                          Height="35"
                          Margin="0,0,0,20" 
                          SelectedValuePath="ID_задачи">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Название_задачи}" 
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Content="Сохранить изменения" 
                        Click="Save_Click" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="220"
                        Height="42"
                        HorizontalAlignment="Center"
                        Margin="0,5,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>