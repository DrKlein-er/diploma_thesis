<Window x:Class="Командное_управление_проектами.Views.EditUserWindow"
        Icon="pack://application:,,,/Resources/checklist.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Командное_управление_проектами.Views"
        mc:Ignorable="d"
        Title="Редактировать пользователя" Height="775" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    
    <Window.Resources>
        <!-- Стиль для заголовков полей -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Стиль для текстовых полей -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для PasswordBox -->
        <Style x:Key="InputPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для кнопки -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="25,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004578"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}" 
            CornerRadius="10" 
            Padding="35" 
            Margin="20"
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1">
        <StackPanel>
            <!-- Заголовок окна -->
            <TextBlock Text="Редактировать пользователя" 
                       FontSize="26" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource ForegroundBrush}"
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,25"/>

            <!-- Поле "Фамилия" -->
            <TextBlock Text="Фамилия:" 
                       Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="LastNameBox" 
                     Style="{StaticResource InputTextBoxStyle}"
                     ToolTip="Введите фамилию пользователя"
                     MaxLength="50"/>

            <!-- Поле "Имя" -->
            <TextBlock Text="Имя:" 
                       Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="FirstNameBox" 
                     Style="{StaticResource InputTextBoxStyle}"
                     ToolTip="Введите имя пользователя"
                     MaxLength="50"/>

            <!-- Поле "Отчество" -->
            <TextBlock Text="Отчество:" 
                       Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="MiddleNameBox" 
                     Style="{StaticResource InputTextBoxStyle}"
                     ToolTip="Введите отчество пользователя (необязательно)"
                     MaxLength="50"/>

            <!-- Поле "Email" -->
            <TextBlock Text="Email:" 
                       Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="EmailBox" 
                     Style="{StaticResource InputTextBoxStyle}"
                     ToolTip="Введите email пользователя"
                     MaxLength="100"/>

            <!-- Поле "Отдел" -->
            <TextBlock Text="Отдел:" 
                       Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="DepartmentComboBox" 
                      Height="35"
                      Margin="0,0,0,15"
                      ToolTip="Выберите отдел сотрудника"/>

            <!-- Поле "Роль" -->
            <TextBlock Text="Роль:" 
                       Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="RoleBox" 
                      Height="35"
                      Margin="0,0,0,15"
                      ToolTip="Выберите роль пользователя">
                <ComboBoxItem Content="Администратор"/>
                <ComboBoxItem Content="Менеджер"/>
                <ComboBoxItem Content="Пользователь"/>
            </ComboBox>

            <!-- Поле "Новый пароль" -->
            <TextBlock Text="Новый пароль (оставьте пустым, если не менять):" 
                       Style="{StaticResource FieldLabelStyle}"/>
            <PasswordBox x:Name="PasswordBox" 
                         Style="{StaticResource InputPasswordBoxStyle}"
                         ToolTip="Минимум 8 символов: заглавные, строчные буквы, цифры и спецсимволы"
                         MaxLength="100"/>

            <!-- Кнопка сохранения -->
            <Button Content="Сохранить изменения" 
                    Click="Save_Click" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="220"
                    Height="42"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,0"/>
        </StackPanel>
    </Border>
</Window>