<Window x:Class="Командное_управление_проектами.LoginWindow"
        Icon="pack://application:,,,/Resources/checklist.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Командное_управление_проектами"
        mc:Ignorable="d"
        Title="Вход в систему" Height="450" Width="450" WindowStartupLocation="CenterScreen">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ECEFF1" Offset="0"/>
            <GradientStop Color="#CFD8DC" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid UseLayoutRounding="True">
        <Border Background="White" CornerRadius="10" Padding="20" Width="300"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Effect="{DynamicResource DropShadowEffect}">
            <StackPanel>
                <TextBlock Text="Вход в систему" FontSize="24" FontWeight="Bold" 
                           Foreground="#424242" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Email:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="EmailBox" Margin="0,0,0,10" Height="30" 
                         BorderBrush="#B0BEC5" BorderThickness="1" Padding="5"/>
                <TextBlock Text="Пароль:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,5" Height="30" 
                             BorderBrush="#B0BEC5" BorderThickness="1" Padding="5"/>
                <TextBox x:Name="VisiblePasswordBox" Margin="0,0,0,5" Height="30" 
                         BorderBrush="#B0BEC5" BorderThickness="1" Padding="5" Visibility="Collapsed"/>
                <CheckBox x:Name="ShowPasswordCheckBox" Content="Показать пароль" 
                          Margin="0,0,0,20" Checked="ShowPasswordCheckBox_Checked" 
                          Unchecked="ShowPasswordCheckBox_Unchecked"/>
                <Button Content="Войти" Click="Login_Click" Width="100" Height="30" 
                        HorizontalAlignment="Center" Background="#007ACC" 
                        Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="Зарегистрироваться" Click="Register_Click" Width="150" Height="30"
                        HorizontalAlignment="Center" Margin="0,10,0,0" Background="#FFC107" 
                        Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" Color="Gray" BlurRadius="10" ShadowDepth="4"/>
    </Window.Resources>
</Window>
