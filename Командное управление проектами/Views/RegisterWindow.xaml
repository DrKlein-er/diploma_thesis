<Window x:Class="Командное_управление_проектами.Views.RegisterWindow"
        Icon="pack://application:,,,/Resources/checklist.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Командное_управление_проектами.Views"
        mc:Ignorable="d"
        Title="Регистрация" Height="700" Width="400" WindowStartupLocation="CenterScreen">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ECEFF1" Offset="0"/>
            <GradientStop Color="#CFD8DC" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Border Background="White" CornerRadius="10" Padding="20" Width="300"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Effect="{DynamicResource DropShadowEffect}">
            <StackPanel>
                <TextBlock Text="Регистрация" FontSize="24" FontWeight="Bold" 
                           Foreground="#424242" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Фамилия:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="LastNameBox" Margin="0,0,0,10" Height="30" 
                         BorderBrush="#B0BEC5" BorderThickness="1" Padding="5"/>

                <TextBlock Text="Имя:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="FirstNameBox" Margin="0,0,0,10" Height="30" 
                         BorderBrush="#B0BEC5" BorderThickness="1" Padding="5"/>

                <TextBlock Text="Отчество:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="MiddleNameBox" Margin="0,0,0,10" Height="30" 
                         BorderBrush="#B0BEC5" BorderThickness="1" Padding="5"/>

                <TextBlock Text="Email:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="EmailBox" Margin="0,0,0,10" Height="30" 
                         BorderBrush="#B0BEC5" BorderThickness="1" Padding="5"/>

                <TextBlock Text="Пароль:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10" Height="30" 
                    BorderBrush="#B0BEC5" BorderThickness="1" Padding="5" PasswordChanged="PasswordBox_PasswordChanged"/>
                <TextBlock Text="Подтвердите пароль:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,10" Height="30" 
                          BorderBrush="#B0BEC5" BorderThickness="1" Padding="5"/>

                <StackPanel Margin="0,0,0,15">
                        <TextBlock x:Name="LengthRequirement" Text="• Минимум 8 символов" FontSize="11" Foreground="Gray"/>
                        <TextBlock x:Name="UpperRequirement" Text="• Одна заглавная буква (A-Z)" FontSize="11" Foreground="Gray"/>
                        <TextBlock x:Name="LowerRequirement" Text="• Одна строчная буква (a-z)" FontSize="11" Foreground="Gray"/>
                        <TextBlock x:Name="DigitRequirement" Text="• Одна цифра (0-9)" FontSize="11" Foreground="Gray"/>
                        <TextBlock x:Name="SymbolRequirement" Text="• Один специальный символ (!, @, #...)" FontSize="11" Foreground="Gray"/>
                 </StackPanel>

                <Button x:Name="RegisterButton" Content="Зарегистрироваться" Click="Register_Click" Width="150" Height="30"
                        HorizontalAlignment="Center" Background="#007ACC" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" Color="Gray" BlurRadius="10" ShadowDepth="4"/>
    </Window.Resources>
</Window>
