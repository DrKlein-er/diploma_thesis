<Window x:Class="Командное_управление_проектами.Views.EditNoteWindow"
        Icon="pack://application:,,,/Resources/checklist.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Командное_управление_проектами.Views"
        mc:Ignorable="d"
        Title="Редактировать заметку" Height="650" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MultilineTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="120"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <Style x:Key="ColorSwatchStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="25,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004578"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}" 
            CornerRadius="10" 
            Padding="35" 
            Margin="20"
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Редактировать заметку" 
                           FontSize="26" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,5"/>
                <TextBlock x:Name="CreatedAtLabel"
                           FontSize="12"
                           Foreground="{DynamicResource ForegroundBrush}"
                           Opacity="0.7"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Заголовок:" 
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="TitleBox" 
                         Style="{StaticResource InputTextBoxStyle}"
                         MaxLength="150"/>

                <TextBlock Text="Текст заметки:" 
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="NoteTextBox" 
                         Style="{StaticResource MultilineTextBoxStyle}"
                         MaxLength="2000"/>

                <TextBlock Text="Цвет:" 
                           Style="{StaticResource FieldLabelStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <RadioButton x:Name="ColorYellow" Tag="Жёлтый" GroupName="Color"
                                 Style="{StaticResource ColorSwatchStyle}"
                                 Background="#FFF59D" ToolTip="Жёлтый"/>
                    <RadioButton x:Name="ColorPink" Tag="Розовый" GroupName="Color"
                                 Style="{StaticResource ColorSwatchStyle}"
                                 Background="#F8BBD0" ToolTip="Розовый"/>
                    <RadioButton x:Name="ColorBlue" Tag="Голубой" GroupName="Color"
                                 Style="{StaticResource ColorSwatchStyle}"
                                 Background="#B3E5FC" ToolTip="Голубой"/>
                    <RadioButton x:Name="ColorGreen" Tag="Зелёный" GroupName="Color"
                                 Style="{StaticResource ColorSwatchStyle}"
                                 Background="#C8E6C9" ToolTip="Зелёный"/>
                    <RadioButton x:Name="ColorGray" Tag="Серый" GroupName="Color"
                                 Style="{StaticResource ColorSwatchStyle}"
                                 Background="#E0E0E0" ToolTip="Серый"/>
                </StackPanel>

                <CheckBox x:Name="PinnedCheckBox"
                          Content="Закрепить заметку (показывать наверху списка)"
                          FontSize="14"
                          Foreground="{DynamicResource ForegroundBrush}"
                          Margin="0,0,0,15"/>

                <TextBlock Text="Привязать к:" 
                           Style="{StaticResource FieldLabelStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton x:Name="LinkNone" Content="Без привязки"
                                 GroupName="LinkType"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 Margin="0,0,15,0"
                                 Checked="LinkType_Changed"/>
                    <RadioButton x:Name="LinkProject" Content="Проекту"
                                 GroupName="LinkType"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 Margin="0,0,15,0"
                                 Checked="LinkType_Changed"/>
                    <RadioButton x:Name="LinkTask" Content="Задаче"
                                 GroupName="LinkType"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 Margin="0,0,15,0"
                                 Checked="LinkType_Changed"/>
                    <RadioButton x:Name="LinkSubtask" Content="Подзадаче"
                                 GroupName="LinkType"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 Checked="LinkType_Changed"/>
                </StackPanel>

                <ComboBox x:Name="ProjectComboBox" 
                          Height="35"
                          Margin="0,0,0,15" 
                          SelectedValuePath="ID_проекта"
                          Visibility="Collapsed">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Название_проекта}" 
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox x:Name="TaskComboBox" 
                          Height="35"
                          Margin="0,0,0,15" 
                          SelectedValuePath="ID_задачи"
                          Visibility="Collapsed">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Название_задачи}" 
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel x:Name="SubtaskPanel" Visibility="Collapsed">
                    <TextBlock Text="Родительская задача:" 
                               FontSize="12"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,5"/>
                    <ComboBox x:Name="ParentTaskComboBox" 
                              Height="35"
                              Margin="0,0,0,10"
                              SelectedValuePath="ID_задачи"
                              SelectionChanged="ParentTaskComboBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Название_задачи}" 
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Подзадача:" 
                               FontSize="12"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,5"/>
                    <ComboBox x:Name="SubtaskComboBox" 
                              Height="35"
                              Margin="0,0,0,15"
                              SelectedValuePath="ID_подзадачи"
                              IsEnabled="False">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Название_подзадачи}" 
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Button Content="Сохранить изменения" 
                        Click="Save_Click" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="220"
                        Height="42"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
