<Window x:Class="Командное_управление_проектами.EditTaskWindow"
        Icon="pack://application:,,,/Resources/checklist.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Командное_управление_проектами"
        mc:Ignorable="d"
        Title="Редактировать задачу" Height="900" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <!-- Стиль для заголовков полей -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Стиль для текстовых полей -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для многострочного текста -->
        <Style x:Key="MultilineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="Height" Value="70"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!-- Стиль для DatePicker -->
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Стиль для кнопки сохранения -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="25,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004578"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок действий (добавить, изменить, удалить) -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}" 
            CornerRadius="10" 
            Padding="25" 
            Margin="15"
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок окна -->
            <TextBlock Text="Редактировать задачу" 
                       Grid.Row="0"
                       FontSize="26" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource ForegroundBrush}"
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

            <!-- TabControl с вкладками -->
            <TabControl Grid.Row="1">
                <!-- Вкладка: Основная информация -->
                <TabItem Header="Основная информация" Height="22" Margin="-2,-2,-2,0" VerticalAlignment="Top">
                    <StackPanel Margin="10">
                        <!-- Поле "Название" -->
                        <TextBlock Text="Название задачи:*" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TitleBox" 
                                 Style="{StaticResource InputTextBoxStyle}"
                                 ToolTip="Введите название задачи"
                                 MaxLength="200"/>

                        <!-- Поле "Описание" -->
                        <TextBlock Text="Описание:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="DescBox" 
                                 Style="{StaticResource MultilineTextBoxStyle}"
                                 ToolTip="Введите описание задачи (необязательно)"
                                 MaxLength="1000"/>

                        <!-- Поле "Приоритет" -->
                        <TextBlock Text="Приоритет:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="PriorityBox" 
                                  Height="35"
                                  Margin="0,0,0,15"
                                  ToolTip="Выберите приоритет задачи">
                            <ComboBoxItem Content="Высокий"/>
                            <ComboBoxItem Content="Средний"/>
                            <ComboBoxItem Content="Низкий"/>
                        </ComboBox>

                        <!-- Поле "Статус" -->
                        <TextBlock Text="Статус:*" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="StatusBox" 
                                  Height="35"
                                  Margin="0,0,0,15"
                                  ToolTip="Выберите статус задачи">
                            <ComboBoxItem Content="Открыта"/>
                            <ComboBoxItem Content="В процессе"/>
                            <ComboBoxItem Content="Завершена"/>
                        </ComboBox>

                        <!-- Поле "Дата начала" -->
                        <TextBlock Text="Дата начала:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker x:Name="StartDatePicker" 
                                    ToolTip="Выберите дату начала задачи"/>

                        <!-- Поле "Дата завершения" -->
                        <TextBlock Text="Дата завершения:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker x:Name="EndDatePicker" 
                                    ToolTip="Выберите дату завершения задачи"/>

                        <!-- Поле "Проект" -->
                        <TextBlock Text="Проект:*" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="ProjectComboBox" 
                                  Height="35"
                                  Margin="0,0,0,15"
                                  SelectedValuePath="ID_проекта"
                                  ToolTip="Выберите проект">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Название_проекта}" 
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Поле "Ответственный" -->
                        <TextBlock Text="Ответственный:" 
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="EmployeeComboBox" 
                                  Height="35"
                                  Margin="0,0,0,15"
                                  SelectedValuePath="ID_сотрудника"
                                  ToolTip="Выберите ответственного сотрудника">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Имя_сотрудника}" 
                                                Foreground="{DynamicResource ForegroundBrush}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Кнопка сохранения -->
                        <Button Content="Сохранить изменения" 
                                Click="Save_Click" 
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="220"
                                Height="40"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0"/>
                    </StackPanel>
                </TabItem>

                <!-- Вкладка: Подзадачи -->
                <TabItem Header="Подзадачи">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Таблица подзадач -->
                        <DataGrid x:Name="SubtasksGrid" 
                                  Grid.Row="0" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  IsReadOnly="True"
                                  Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" 
                                                    Binding="{Binding Название_подзадачи}" 
                                                    Width="2*"/>
                                <DataGridTextColumn Header="Статус" 
                                                    Binding="{Binding Статус}" 
                                                    Width="*"/>
                                <DataGridTextColumn Header="Срок выполнения" 
                                                    Binding="{Binding Срок_выполнения, StringFormat='dd.MM.yyyy'}" 
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Кнопки управления подзадачами -->
                        <StackPanel Grid.Row="1" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Right">
                            <Button Content="Добавить" 
                                    Click="AddSubtask_Click" 
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Изменить" 
                                    Click="EditSubtask_Click" 
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Удалить" 
                                    Click="DeleteSubtask_Click" 
                                    Style="{StaticResource ActionButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Вкладка: Файлы -->
                <TabItem Header="Файлы">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Список файлов -->
                        <ListBox x:Name="FilesListBox" 
                                 Grid.Row="0" 
                                 DisplayMemberPath="Название_файла"
                                 Margin="0,0,0,10" Grid.ColumnSpan="2"/>

                        <!-- Кнопки управления файлами -->
                        <StackPanel Grid.Row="1" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Left" Grid.ColumnSpan="2" Margin="136,0,0,0">
                            <Button Content="Добавить файл" 
                                    Click="AddFile_Click" 
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Открыть файл" 
                                    Click="OpenFile_Click" 
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Удалить файл" 
                                    Click="DeleteFile_Click" 
                                    Style="{StaticResource ActionButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
