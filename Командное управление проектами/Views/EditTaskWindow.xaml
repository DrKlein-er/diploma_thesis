<Window x:Class="Командное_управление_проектами.EditTaskWindow"
        Icon="pack://application:,,,/Resources/checklist.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Командное_управление_проектами"
        mc:Ignorable="d"
        Title="Редактировать задачу" Height="850" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Border Background="{DynamicResource BackgroundBrush}" 
            CornerRadius="10" 
            Padding="35" 
            Margin="20"
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок окна -->
            <TextBlock Text="Редактировать задачу" 
                       Grid.Row="0"
                       FontSize="26" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource ForegroundBrush}"
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,25"/>

            <!-- TabControl с вкладками -->
            <TabControl Grid.Row="1">
                <!-- Вкладка: Основная информация -->
                <TabItem Header="Основная информация">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20">
                            <!-- Поле "Название" -->
                            <TextBlock Text="Название задачи:" 
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TitleBox" 
                                     Style="{StaticResource InputTextBoxStyle}"
                                     ToolTip="Введите название задачи"
                                     MaxLength="200"
                                     />

                            <!-- Поле "Описание" -->
                            <TextBlock Text="Описание:" 
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="DescBox" 
                                     Style="{StaticResource MultilineTextBoxStyle}"
                                     ToolTip="Введите описание задачи (необязательно)"
                                     MaxLength="1000"/>

                            <!-- Поле "Приоритет" -->
                            <TextBlock Text="Приоритет:" 
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="PriorityBox" 
                                      Height="35"
                                      Margin="0,0,0,15"
                                      ToolTip="Выберите приоритет задачи">
                                <ComboBoxItem Content="Высокий"/>
                                <ComboBoxItem Content="Средний"/>
                                <ComboBoxItem Content="Низкий"/>
                            </ComboBox>

                            <!-- Поле "Статус" -->
                            <TextBlock Text="Статус:" 
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="StatusBox" 
                                      Height="35"
                                      Margin="0,0,0,15"
                                      ToolTip="Выберите статус задачи">
                                <ComboBoxItem Content="Открыта"/>
                                <ComboBoxItem Content="В процессе"/>
                                <ComboBoxItem Content="Завершена"/>
                            </ComboBox>

                            <!-- Поле "Дата начала" -->
                            <TextBlock Text="Дата начала:" 
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <DatePicker x:Name="StartDatePicker"
                                        Height="35"
                                        Margin="0,0,0,15"
                                        ToolTip="Выберите дату начала задачи"/>

                            <!-- Поле "Дата завершения" -->
                            <TextBlock Text="Дата завершения:" 
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <DatePicker x:Name="EndDatePicker"
                                        Height="35"
                                        Margin="0,0,0,15"
                                        ToolTip="Выберите дату завершения задачи"/>

                            <!-- Поле "Проект" -->
                            <TextBlock Text="Проект:" 
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="ProjectComboBox" 
                                      Height="35"
                                      Margin="0,0,0,15"
                                      SelectedValuePath="ID_проекта"
                                      ToolTip="Выберите проект">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Название_проекта}" 
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Поле "Ответственный" -->
                            <TextBlock Text="Ответственный:" 
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="EmployeeComboBox" 
                                      Height="35"
                                      Margin="0,0,0,15"
                                      SelectedValuePath="ID_сотрудника"
                                      ToolTip="Выберите ответственного сотрудника">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Имя_сотрудника}" 
                                                  Foreground="{DynamicResource ForegroundBrush}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Кнопка сохранения -->
                            <Button x:Name="SaveTaskBtn"
                                    Content="Сохранить изменения" 
                                    Click="Save_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="220"
                                    Height="42"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Вкладка: Подзадачи -->
                <TabItem Header="Подзадачи">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Таблица подзадач -->
                        <DataGrid x:Name="SubtasksGrid" 
                                  Grid.Row="0" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  IsReadOnly="True"
                                  Margin="0,0,0,15">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" 
                                                    Binding="{Binding Название_подзадачи}" 
                                                    Width="2*"/>
                                <DataGridTextColumn Header="Статус" 
                                                    Binding="{Binding Статус}" 
                                                    Width="*"/>
                                <DataGridTextColumn Header="Дата завершения" 
                                                    Binding="{Binding Дата_завершения, StringFormat='dd.MM.yyyy'}" 
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Кнопки управления подзадачами -->
                        <StackPanel Grid.Row="1" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Center">
                            <Button Content="Добавить" 
                                    Click="AddSubtask_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="160"
                                    Margin="5"/>
                            <Button Content="Изменить" 
                                    Click="EditSubtask_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="160"
                                    Margin="5"/>
                            <Button Content="Удалить" 
                                    Click="DeleteSubtask_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="160"
                                    Margin="5"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Вкладка: Файлы -->
                <TabItem Header="Файлы">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Список файлов -->
                        <ListBox x:Name="FilesListBox" 
                                 Grid.Row="0" 
                                 DisplayMemberPath="Название_файла"
                                 Margin="0,0,0,15"
                                 Background="{DynamicResource TextBoxBackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>

                        <!-- Кнопки управления файлами -->
                        <StackPanel Grid.Row="1" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Center">
                            <Button Content="Добавить файл" 
                                    Click="AddFile_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="160"
                                    Margin="5"/>
                            <Button Content="Открыть файл" 
                                    Click="OpenFile_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="160"
                                    Margin="5"/>
                            <Button Content="Удалить файл" 
                                    Click="DeleteFile_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="160"
                                    Margin="5"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                
                <!-- Вкладка: История изменений -->
                <TabItem x:Name="HistoryTab" Header="История">
                    <DataGrid x:Name="HistoryGrid" 
                  Margin="20"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Дата_изменения, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding Имя_сотрудника}" Width="*"/>
                            <DataGridTextColumn Header="Изменение" Binding="{Binding Описание_изменения}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>